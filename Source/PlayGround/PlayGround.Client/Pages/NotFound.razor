@* 404 — Design.Navigation. Router의 NotFoundPage로도 연결된다(App.razor). *@
@attribute [Route(Routes.NotFound)]
@layout LandingLayout
@using PlayGround.Client.Components.Shared.Error
@using PlayGround.Client.Styles

<PageTitle>@AppText.Shared.NotFoundPageTitle</PageTitle>

<div class="min-h-screen bg-bg flex flex-col text-navy-deep">
    <PublicGnb />
    <ErrorPageBody Kind="ErrorPageBody.Art.Pitch" StatusCode="404" Title="@AppText.Shared.NotFoundTitle">
        <Description>@AppText.Shared.NotFoundBody1<br />@AppText.Shared.NotFoundBody2</Description>
        <Actions>
            <a href="@Routes.Landing" class="@Css.Error.PrimaryButton">@AppText.Shared.GoHome</a>
            <a href="@Routes.TeamExplore" class="@Css.Error.SecondaryButton">@AppText.Shared.ExploreTeams</a>
        </Actions>
    </ErrorPageBody>
</div>

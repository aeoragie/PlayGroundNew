@attribute [Route(Routes.OnboardingComplete)]
@layout AuthLayout
@using PlayGround.Client.Styles
@inject NavigationManager Nav
@inject OnboardingState State

<PageTitle>@AppText.Auth.CompletePageTitle</PageTitle>

@* ④ 완료 — player | team | general 3분기 *@
<div class="@($"w-[480px] max-w-full {Css.Auth.Card} px-10 py-12 flex flex-col items-center gap-[18px] text-center")">
    <div class="w-[72px] h-[72px] rounded-full bg-teal/[.12] border-1.5 border-teal/40 flex items-center justify-center text-[34px]">@Icon</div>
    <h1 class="m-0 text-2xl font-extrabold tracking-[-.02em] text-navy-deep">@Title</h1>
    <p class="m-0 text-[14.5px] text-text-body leading-[1.7]">@Body</p>

    @if (IsTeam)
    {
        <div class="flex items-center gap-2.5 bg-surface-alt rounded-[11px] px-[18px] py-3 text-[13.5px] font-bold text-navy">
            🔗 playground.kr/team/@State.TeamSlug
            <span class="@Css.Badge.Positive">@AppText.Auth.CompletePublished</span>
        </div>
        <div class="text-[13px] text-text-body">@AppText.Auth.CompleteRosterSummary(State.RosterCount)</div>
    }

    <button type="button" @onclick="GoDashboard" class="@($"mt-2 px-8 {Css.Auth.PrimaryButton}")">@PrimaryLabel</button>
</div>

@code {
    private bool IsTeam => State.DoneFrom == OnboardingRole.Team;

    private string Icon => State.DoneFrom switch
    {
        OnboardingRole.Team => "🏛️",
        OnboardingRole.General => "👋",
        _ => "⚽"
    };

    private string Title => State.DoneFrom switch
    {
        OnboardingRole.Team => AppText.Auth.CompleteTeamTitle,
        OnboardingRole.General => AppText.Auth.CompleteGeneralTitle,
        _ => AppText.Auth.CompletePlayerTitle
    };

    private string Body => State.DoneFrom switch
    {
        OnboardingRole.Team => AppText.Auth.CompleteTeamBody,
        OnboardingRole.General => AppText.Auth.CompleteGeneralBody,
        _ => AppText.Auth.CompletePlayerBody
    };

    // General은 대시보드가 없으니 경기기록(둘러보기)으로 — 역할 재선택은 Records 유도 배너로
    private bool IsGeneral => State.DoneFrom == OnboardingRole.General;

    private string PrimaryLabel => IsGeneral ? AppText.Auth.CompletePrimaryRecords : AppText.Auth.CompletePrimaryDashboard;

    private void GoDashboard()
    {
        State.Reset();
        Nav.NavigateTo(IsGeneral ? Routes.Records : Routes.Dashboard);
    }
}

@attribute [Route(Routes.SelectRole)]
@layout AuthLayout
@using PlayGround.Client.Models
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Auth
@inject NavigationManager Nav
@inject OnboardingState State
@inject JwtAuthenticationStateProvider AuthProvider
@inject AuthClient Auth

<PageTitle>@AppText.Auth.RolePageTitle</PageTitle>

@if (mChecking)
{
    <div class="w-[560px] max-w-full flex items-center justify-center py-24 text-text-muted text-sm">@AppText.Auth.Checking</div>
}
else
{
@* ② 역할 선택 *@
<div class="w-[560px] max-w-full flex flex-col gap-6">
    <div class="text-center flex flex-col gap-2">
        <h1 class="m-0 text-[26px] font-extrabold tracking-[-.02em] text-navy-deep">@AppText.Auth.RoleHeading</h1>
        <p class="m-0 text-[14.5px] text-text-body">@AppText.Auth.RoleSubtitle</p>
    </div>

    <div class="flex flex-col gap-3.5">
        @* 선수·학부모 *@
        <button type="button" @onclick="StartPlayer"
                class="flex items-center gap-[18px] text-left bg-white border-1.5 border-border rounded-2xl px-6 py-[22px] cursor-pointer hover:border-navy hover:shadow-[0_4px_16px_rgba(28,43,74,.08)] transition-all">
            <span class="w-[52px] h-[52px] rounded-[14px] bg-surface-icon flex items-center justify-center text-[25px] flex-none">⚽</span>
            <span class="flex flex-col gap-1 flex-1">
                <span class="text-[17.5px] font-extrabold text-navy-deep">@AppText.Auth.RolePlayerTitle</span>
                <span class="text-[13.5px] text-text-body leading-[1.55]">@AppText.Auth.RolePlayerBody</span>
            </span>
            <span class="text-[18px] text-text-faint">→</span>
        </button>

        @* 팀 관리자·코치 *@
        <button type="button" @onclick="StartTeam"
                class="flex items-center gap-[18px] text-left bg-white border-1.5 border-border rounded-2xl px-6 py-[22px] cursor-pointer hover:border-navy hover:shadow-[0_4px_16px_rgba(28,43,74,.08)] transition-all">
            <span class="w-[52px] h-[52px] rounded-[14px] bg-navy-deep flex items-center justify-center text-[25px] flex-none">🏛️</span>
            <span class="flex flex-col gap-1 flex-1">
                <span class="text-[17.5px] font-extrabold text-navy-deep">@AppText.Auth.RoleTeamTitle</span>
                <span class="text-[13.5px] text-text-body leading-[1.55]">@AppText.Auth.RoleTeamBody</span>
            </span>
            <span class="text-[18px] text-text-faint">→</span>
        </button>

        @* 에이전트 (비활성) — feature flag OFF면 항목 자체 미노출 (Design.AgentDashboard). 로그인은 별도 서비스 SSO. *@
        @if (FeatureFlags.AgentApproval)
        {
            <div class="flex items-center gap-[18px] bg-[#fafbfc] border-1.5 border-dashed border-border rounded-2xl px-6 py-[22px] opacity-70">
                <span class="w-[52px] h-[52px] rounded-[14px] bg-surface-icon flex items-center justify-center text-[25px] flex-none">🤝</span>
                <span class="flex flex-col gap-1 flex-1">
                    <span class="text-[17.5px] font-extrabold text-text-muted">@AppText.Auth.RoleAgentTitle
                        <span class="@Css.Badge.Agent">@AppText.Auth.RoleAgentSoon</span>
                    </span>
                    <span class="text-[13.5px] text-text-muted leading-[1.55]">@AppText.Auth.RoleAgentBody</span>
                </span>
            </div>
        }
    </div>

    <button type="button" @onclick="SkipRole" class="@($"{Css.Auth.TextLink} self-center py-1")">@AppText.Auth.RoleSkip</button>
</div>
}

@code {
    private bool mChecking = true;

    protected override async Task OnInitializedAsync()
    {
        // OAuth 콜백은 /settings/select-role#access_token=... 로 리다이렉트된다.
        // fragment에서 토큰을 꺼내 저장·인증 갱신한 뒤, 주소에서 토큰을 제거한다.
        string? token = ExtractAccessToken(Nav.Uri);
        if (!string.IsNullOrWhiteSpace(token))
        {
            await AuthProvider.MarkUserAuthenticatedAsync(token);
            Nav.NavigateTo(Routes.SelectRole, replace: true);
        }

        // 이미 역할을 가진 기존 사용자는 역할 선택을 건너뛰고 대시보드로 직행.
        AuthUserDto? me = await Auth.GetMeAsync();
        if (me is not null && UserRoleExtensions.Parse(me.Role) != UserRole.General)
        {
            Nav.NavigateTo(Routes.Dashboard, replace: true);
            return;
        }

        mChecking = false;
    }

    private static string? ExtractAccessToken(string uri)
    {
        int hashIndex = uri.IndexOf('#');
        if (hashIndex < 0)
        {
            return null;
        }

        const string prefix = "access_token=";
        string fragment = uri[(hashIndex + 1)..];
        foreach (string part in fragment.Split('&'))
        {
            if (part.StartsWith(prefix, StringComparison.Ordinal))
            {
                return Uri.UnescapeDataString(part[prefix.Length..]);
            }
        }

        return null;
    }

    private void StartPlayer() => Nav.NavigateTo(Routes.PlayerOnboarding);
    private void StartTeam() => Nav.NavigateTo(Routes.TeamOnboarding);

    private void SkipRole()
    {
        State.DoneFrom = OnboardingRole.General;
        Nav.NavigateTo(Routes.OnboardingComplete);
    }
}

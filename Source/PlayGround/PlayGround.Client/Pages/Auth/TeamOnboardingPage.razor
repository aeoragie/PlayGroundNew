@attribute [Route(Routes.TeamOnboarding)]
@layout AuthLayout
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Team
@inject NavigationManager Nav
@inject OnboardingState State
@inject TeamClient Teams
@inject JwtAuthenticationStateProvider AuthProvider

<PageTitle>@AppText.Auth.TeamPageTitle</PageTitle>

@* ③b 팀 온보딩 (2스텝) *@
@if (mChecking)
{
    <div class="w-[560px] max-w-full flex items-center justify-center py-24 text-text-muted text-sm">@AppText.Auth.Checking</div>
}
else
{
<div class="w-[560px] max-w-full flex flex-col gap-5">
    <div class="flex flex-col gap-3">
        <h1 class="m-0 text-[23px] font-extrabold tracking-[-.02em] text-navy-deep">@StepTitle</h1>
        @* 공용 스텝퍼로 교체 (Design.BannerStepper §2) — Current는 0부터. 완료 스텝만 클릭돼 뒤로 이동. *@
        <Stepper Steps="StepLabels" Current="@(mStep - 1)" OnStepClick="@(i => mStep = i + 1)" />
    </div>

    <div class="@($"{Css.Auth.Card} px-7 py-[30px] flex flex-col gap-4")">
        @if (mStep == 1)
        {
            <div class="flex flex-col gap-4">
                <div class="flex gap-4 items-start">
                    <div class="w-[76px] h-[76px] border-1.5 border-dashed border-text-faint rounded-[14px] flex flex-col items-center justify-center gap-[3px] text-text-muted text-[11px] flex-none cursor-pointer hover:border-navy hover:text-navy transition-colors">
                        <span class="text-[20px]">🛡️</span>@AppText.Auth.Emblem
                    </div>
                    <label class="flex flex-col gap-[7px] text-[13.5px] font-bold text-text-strong flex-1">@AppText.Auth.TeamNameLabel
                        <input type="text" placeholder="@AppText.Auth.TeamNamePlaceholder" class="@Css.Auth.Input" @bind="mTeamName" @bind:event="oninput" /></label>
                </div>
                <div class="flex flex-col gap-2">
                    <span class="text-[13.5px] font-bold text-text-strong">@AppText.Auth.TeamTypeLabel</span>
                    <div class="flex gap-2">
                        @foreach (var type in TeamTypes)
                        {
                            <ChoiceChip Label="@type" Selected="@(mTeamType == type)" OnClick="@(() => mTeamType = type)" />
                        }
                    </div>
                </div>
                <label class="flex flex-col gap-[7px] text-[13.5px] font-bold text-text-strong">@AppText.Auth.RegionLabel
                    <input type="text" placeholder="@AppText.Auth.TeamRegionPlaceholder" class="@Css.Auth.Input" @bind="mRegion" @bind:event="oninput" /></label>
                <div class="flex gap-2.5 items-start bg-surface-alt rounded-[11px] px-3.5 py-3">
                    <span class="text-[15px]">🏠</span>
                    <span class="text-[12.5px] text-text-strong leading-relaxed">@AppText.Auth.TeamHomeHintPrefix<b>@AppText.Auth.TeamHomeHintBold</b>@AppText.Auth.TeamHomeHintSuffix</span>
                </div>
            </div>
        }
        else
        {
            <div class="flex flex-col gap-3.5">
                <div class="flex gap-2">
                    <input type="text" @bind="mName" @bind:event="oninput" placeholder="@AppText.Auth.RosterNamePlaceholder" class="[flex:1.4] h-[46px] border-1.5 border-border rounded-[11px] px-[13px] text-sm font-medium min-w-0 placeholder:text-text-faint focus:outline-none focus:ring-2 focus:ring-navy focus:border-navy" />
                    <input type="text" @bind="mPos" @bind:event="oninput" placeholder="@AppText.Auth.RosterPositionPlaceholder" class="flex-1 h-[46px] border-1.5 border-border rounded-[11px] px-[13px] text-sm font-medium min-w-0 placeholder:text-text-faint focus:outline-none focus:ring-2 focus:ring-navy focus:border-navy" />
                    <input type="text" @bind="mNum" @bind:event="oninput" placeholder="@AppText.Auth.RosterNumberPlaceholder" class="w-[72px] h-[46px] border-1.5 border-border rounded-[11px] px-[13px] text-sm font-medium placeholder:text-text-faint focus:outline-none focus:ring-2 focus:ring-navy focus:border-navy" />
                    <button type="button" @onclick="AddRoster" class="h-[46px] px-[18px] rounded-[11px] bg-navy hover:bg-navy-deep text-white text-sm font-bold whitespace-nowrap transition-colors">@AppText.Auth.RosterAdd</button>
                </div>

                <div class="flex flex-col gap-2 max-h-[260px] overflow-y-auto">
                    @foreach (var entry in State.Roster)
                    {
                        var captured = entry;
                        <div class="flex items-center gap-3 border border-border rounded-[11px] px-3.5 py-[11px]">
                            <span class="w-[34px] h-[34px] rounded-full bg-surface-icon flex items-center justify-center text-sm font-extrabold text-navy flex-none">@entry.Number</span>
                            <span class="text-[14.5px] font-bold flex-1 text-navy-deep">@entry.Name</span>
                            <span class="text-[13px] text-text-body">@entry.Position</span>
                            <span class="@Css.Badge.Neutral">Unclaimed</span>
                            <button type="button" @onclick="@(() => State.Roster.Remove(captured))" class="border-0 bg-transparent text-text-faint hover:text-[#e0532f] text-[15px] cursor-pointer p-0.5 transition-colors">✕</button>
                        </div>
                    }
                </div>

                <div class="flex gap-2.5 items-start bg-surface-orange border border-dashed border-orange rounded-[11px] px-3.5 py-3">
                    <span class="text-[15px]">💡</span>
                    <span class="text-[12.5px] text-text-strong leading-relaxed">@AppText.Auth.RosterHintPrefix<b>@AppText.Auth.RosterHintBold1</b>@AppText.Auth.RosterHintMiddle<b>@AppText.Auth.RosterHintBold2</b>@AppText.Auth.RosterHintSuffix</span>
                </div>
            </div>
        }
    </div>

    @if (mError is not null)
    {
        <div role="alert" class="rounded-[11px] bg-surface-alt border-1.5 border-border text-[13px] text-text-body px-4 py-3 text-center">@mError</div>
    }

    <div class="flex gap-2.5">
        @if (mStep == 2)
        {
            <button type="button" @onclick="() => mStep = 1" disabled="@mSaving" class="@Css.Auth.SecondaryButton">@AppText.Auth.Back</button>
        }
        <button type="button" @onclick="Next" disabled="@mSaving" class="@($"flex-1 {Css.Auth.PrimaryButton}")">@(mSaving ? AppText.Auth.Creating : NextLabel)</button>
    </div>
    @if (mStep == 2)
    {
        <button type="button" @onclick="Submit" disabled="@mSaving" class="@($"{Css.Auth.TextLink} !text-[13px]")">@AppText.Auth.RegisterLater</button>
    }
</div>
}

@code {
    private static readonly string[] TeamTypes = [AppText.Auth.TeamTypeClub, AppText.Auth.TeamTypeSchool, AppText.Auth.TeamTypeAcademy];

    private bool mChecking = true;
    private int mStep = 1;
    private string mTeamType = AppText.Auth.TeamTypeClub;

    // 온보딩 중복 방지 — 이미 팀이 있는 계정이 재진입하면 폼을 보여주지 않고 대시보드로.
    // (서버 프로시저도 멱등이라 최종 방어는 이중이다: 화면 가드 + 생성 프로시저 기존 반환.)
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity is not { IsAuthenticated: true })
        {
            Nav.NavigateTo(Routes.LoginWithReturn(Routes.TeamOnboarding), replace: true);
            return;
        }

        TeamInfoResponse? existing = await Teams.GetTeamInfoAsync();
        if (existing is not null)
        {
            Nav.NavigateTo(Routes.Dashboard, replace: true);
            return;
        }

        mChecking = false;
    }

    private string mTeamName = string.Empty;
    private string mRegion = string.Empty;
    private string mName = string.Empty;
    private string mPos = string.Empty;
    private string mNum = string.Empty;
    private string? mError;
    private bool mSaving;

    private static readonly string[] StepLabels = [AppText.Auth.TeamStepLabel1, AppText.Auth.TeamStepLabel2];
    private string StepTitle => mStep == 1 ? AppText.Auth.TeamStepLabel1 : AppText.Auth.TeamStep2Title;
    private string NextLabel => mStep == 1 ? AppText.Auth.TeamNextRoster : AppText.Auth.TeamCreateHome;

    private void AddRoster()
    {
        if (string.IsNullOrWhiteSpace(mName))
        {
            return;
        }

        State.Roster.Add(new RosterEntry
        {
            Name = mName.Trim(),
            Position = string.IsNullOrWhiteSpace(mPos) ? "-" : mPos.Trim(),
            Number = string.IsNullOrWhiteSpace(mNum) ? "-" : mNum.Trim()
        });
        mName = mPos = mNum = string.Empty;
    }

    private async Task Next()
    {
        mError = null;

        if (mStep == 1)
        {
            if (string.IsNullOrWhiteSpace(mTeamName))
            {
                mError = AppText.Auth.ErrorTeamName;
                return;
            }

            mStep = 2;
            return;
        }

        await Submit();
    }

    // 팀 생성(POST). "팀 홈페이지 만들기"·"나중에 등록할게요" 공통 — 후자는 로스터를 더 추가하지 않은 채 생성.
    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(mTeamName))
        {
            mError = AppText.Auth.ErrorTeamName;
            mStep = 1;
            return;
        }

        mSaving = true;
        mError = null;

        var request = new CreateTeamRequest
        {
            TeamName = mTeamName.Trim(),
            TeamType = mTeamType,
            Region = string.IsNullOrWhiteSpace(mRegion) ? null : mRegion.Trim(),
            Roster = State.Roster
                .Select(r => new RosterEntryDto { Name = r.Name, Position = r.Position, Number = r.Number })
                .ToList()
        };

        TeamSaveResult result = await Teams.CreateTeamAsync(request);
        mSaving = false;

        if (!result.Success)
        {
            mError = result.Error;
            return;
        }

        // 승격된 역할(TeamAdmin)의 새 토큰으로 교체 — 재로그인 없이 /dashboard 분기가 맞도록.
        if (!string.IsNullOrWhiteSpace(result.AccessToken))
        {
            await AuthProvider.MarkUserAuthenticatedAsync(result.AccessToken);
        }

        State.DoneFrom = OnboardingRole.Team;
        State.TeamSlug = result.Slug ?? string.Empty;
        Nav.NavigateTo(Routes.OnboardingComplete);
    }
}

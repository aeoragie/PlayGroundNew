@attribute [Route(Routes.PlayerOnboarding)]
@layout AuthLayout
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Player
@inject NavigationManager Nav
@inject OnboardingState State
@inject PlayerClient Players
@inject JwtAuthenticationStateProvider AuthProvider

<PageTitle>@AppText.Auth.PlayerPageTitle</PageTitle>

@* ③a 선수 온보딩 (3스텝) *@
<div class="w-[480px] max-w-full flex flex-col gap-5">
    <div class="flex flex-col gap-3">
        <h1 class="m-0 text-[23px] font-extrabold tracking-[-.02em] text-navy-deep">@StepTitle</h1>
        @* 공용 스텝퍼로 교체 (Design.BannerStepper §2) — Current는 0부터라 mStep-1을 넘긴다.
           완료 스텝 클릭은 뒤로 이동만 하고 입력은 필드에 남아 유지된다. *@
        <Stepper Steps="StepLabels" Current="@(mStep - 1)" OnStepClick="GoToStep" />
    </div>

    <div class="@($"{Css.Auth.Card} px-7 py-[30px] flex flex-col gap-4")">
        @if (mStep == 1)
        {
            <div class="flex flex-col gap-3.5">
                <label class="flex flex-col gap-[7px] text-[13.5px] font-bold text-text-strong">@AppText.Auth.PlayerNameLabel
                    <input type="text" placeholder="@AppText.Auth.PlayerNamePlaceholder" class="@Css.Auth.Input" @bind="mName" @bind:event="oninput" /></label>
                <label class="flex flex-col gap-[7px] text-[13.5px] font-bold text-text-strong">@AppText.Auth.BirthDateLabel
                    <input type="text" placeholder="YYYY.MM.DD" class="@Css.Auth.Input" @bind="mBirth" @bind:event="oninput" /></label>
                <div class="flex gap-2.5 items-start bg-surface-teal border border-teal/30 rounded-[11px] px-3.5 py-3">
                    <span class="text-[15px]">👪</span>
                    <span class="text-[12.5px] text-text-strong leading-relaxed">@AppText.Auth.GuardianHint<b>@AppText.Auth.GuardianHintBold</b>@AppText.Auth.GuardianHintSuffix</span>
                </div>
            </div>
        }
        else if (mStep == 2)
        {
            <div class="flex flex-col gap-4">
                <div class="flex flex-col gap-2">
                    <span class="text-[13.5px] font-bold text-text-strong">@AppText.Auth.AgeGroupLabel</span>
                    <div class="flex gap-2">
                        @foreach (var age in AgeOptions)
                        {
                            <ChoiceChip Label="@age" Selected="@(mAge == age)" OnClick="@(() => mAge = age)" />
                        }
                    </div>
                </div>
                <div class="flex flex-col gap-2">
                    <span class="text-[13.5px] font-bold text-text-strong">@AppText.Auth.SportLabel</span>
                    <div class="flex items-center gap-2.5 h-12 border-1.5 border-border rounded-[11px] px-[15px] bg-[#fafbfc]">
                        <span>⚽</span><span class="text-[14.5px] font-bold text-navy-deep">@AppText.Auth.SportSoccer</span>
                        <span class="@Css.Badge.Neutral">@AppText.Auth.SportSoccerOnly</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="flex flex-col gap-3.5">
                <label class="flex flex-col gap-[7px] text-[13.5px] font-bold text-text-strong">@AppText.Auth.RegionLabel
                    <input type="text" placeholder="@AppText.Auth.PlayerRegionPlaceholder" class="@Css.Auth.Input" @bind="mRegion" @bind:event="oninput" /></label>
                <label class="flex flex-col gap-[7px] text-[13.5px] font-bold text-text-strong">@AppText.Auth.TeamLabel <span class="font-medium text-text-muted">@AppText.Auth.Optional</span>
                    <input type="text" placeholder="@AppText.Auth.TeamSearchPlaceholder" class="@Css.Auth.Input" /></label>
                <div class="flex gap-2.5 items-start bg-surface-orange border border-dashed border-orange rounded-[11px] px-3.5 py-3">
                    <span class="text-[15px]">✉️</span>
                    <span class="text-[12.5px] text-text-strong leading-relaxed">@AppText.Auth.InviteHintPrefix<b>@AppText.Auth.InviteHintBold</b>@AppText.Auth.InviteHintSuffix</span>
                </div>
            </div>
        }
    </div>

    @if (mError is not null)
    {
        <div role="alert" class="rounded-[11px] bg-surface-alt border-1.5 border-border text-[13px] text-text-body px-4 py-3 text-center">@mError</div>
    }

    <div class="flex gap-2.5">
        @if (mStep > 1)
        {
            <button type="button" @onclick="Back" disabled="@mSaving" class="@Css.Auth.SecondaryButton">@AppText.Auth.Back</button>
        }
        <button type="button" @onclick="Next" disabled="@mSaving" class="@($"flex-1 {Css.Auth.PrimaryButton}")">@(mSaving ? AppText.Auth.Saving : NextLabel)</button>
    </div>
    @if (mStep == 3)
    {
        <button type="button" @onclick="Submit" disabled="@mSaving" class="@($"{Css.Auth.TextLink} !text-[13px]")">@AppText.Auth.SkipStep</button>
    }
</div>

@code {
    private static readonly string[] AgeOptions = ["U12", "U15", "U18"];
    private static readonly Dictionary<int, string> Titles = new() { [1] = AppText.Auth.PlayerStep1Title, [2] = AppText.Auth.PlayerStep2Title, [3] = AppText.Auth.PlayerStep3Title };
    // 스텝퍼 레이블 — 좁은 폭(10.5px nowrap)이라 제목보다 짧게
    private static readonly string[] StepLabels = [AppText.Auth.PlayerStepLabel1, AppText.Auth.PlayerStepLabel2, AppText.Auth.PlayerStepLabel3];

    private int mStep = 1;
    private string mAge = "U15";
    private string mName = string.Empty;
    private string mBirth = string.Empty;
    private string mRegion = string.Empty;
    private string? mError;
    private bool mSaving;

    private string StepTitle => Titles[mStep];
    private string NextLabel => mStep < 3 ? AppText.Auth.Next : AppText.Auth.CreateProfile;

    private void Back()
    {
        mError = null;
        mStep--;
    }

    // 스텝퍼 도트 클릭 — 완료 스텝(뒤)만 넘어온다. 입력은 필드에 남아 유지된다.
    private void GoToStep(int index)
    {
        mError = null;
        mStep = index + 1;
    }

    private async Task Next()
    {
        mError = null;

        // 이름은 필수 — 1스텝 통과 전 검증
        if (mStep == 1 && string.IsNullOrWhiteSpace(mName))
        {
            mError = AppText.Auth.ErrorPlayerName;
            return;
        }

        if (mStep < 3)
        {
            mStep++;
            return;
        }

        await Submit();
    }

    // 프로필 생성(POST). "프로필 만들기"·"이 단계 건너뛰기" 공통 — 건너뛰기는 지역만 비운 채 저장.
    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(mName))
        {
            mError = AppText.Auth.ErrorPlayerName;
            mStep = 1;
            return;
        }

        mSaving = true;
        mError = null;

        var request = new CreatePlayerProfileRequest
        {
            Name = mName.Trim(),
            BirthDate = string.IsNullOrWhiteSpace(mBirth) ? null : mBirth.Trim(),
            AgeGroup = mAge,
            Region = string.IsNullOrWhiteSpace(mRegion) ? null : mRegion.Trim()
        };

        PlayerSaveResult result = await Players.CreateProfileAsync(request);
        mSaving = false;

        if (!result.Success)
        {
            mError = result.Error;
            return;
        }

        // 승격된 역할(Player)의 새 토큰으로 교체 — 재로그인 없이 /dashboard 분기가 맞도록.
        if (!string.IsNullOrWhiteSpace(result.AccessToken))
        {
            await AuthProvider.MarkUserAuthenticatedAsync(result.AccessToken);
        }

        State.DoneFrom = OnboardingRole.Player;
        Nav.NavigateTo(Routes.OnboardingComplete);
    }
}

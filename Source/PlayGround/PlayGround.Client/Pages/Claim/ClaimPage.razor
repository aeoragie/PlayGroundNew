@attribute [Route(Routes.Claim)]
@* 보호자 Claim 4스텝 (Design.ClaimFlow) — 초대코드 → 프로필 확인 → 승인 대기 → 연결 완료.
   모바일 우선(카드 420px 중앙) — PC도 동일 카드. 기존 즉시 연결(선수 대시보드 초대코드 카드)과 별개 경로.
   재방문 복원: 내 최신 요청이 Pending이면 대기, Approved면 완료 화면에서 시작한다.
   레퍼런스의 "시점 전환" 바·"(프로토타입) →" 버튼은 구현하지 않는다. *@
@using PlayGround.Client.Services.Feedback
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Claim
@using PlayGround.Domain.Soccer
@inject NavigationManager Nav
@inject JwtAuthenticationStateProvider AuthProvider
@inject ClaimClient Claims
@inject ToastService Toasts
@inject ConfirmService Confirm

<PageTitle>@AppText.Claim.PageTitle</PageTitle>

<div class="@Css.Claim.Screen">
    <div class="@Css.Claim.Column">
        <Stepper Steps="@StepLabels" Current="@mStep" OnStepClick="GoBackTo" />

        <div class="@Css.Claim.Card">
            <div class="@Css.Claim.CardTop">
                <BrandLogo Compact="true" />
                <div class="flex-1"></div>
                <span class="@Css.Claim.CardTopLabel">@AppText.Claim.CardTopLabel</span>
            </div>

            @if (mStep == 0)
            {
                @* ── STEP 1: 초대코드 입력 ── *@
                <div class="@Css.Claim.Body">
                    <div class="flex flex-col gap-[7px]">
                        <h1 class="@Css.Claim.Title">@AppText.Claim.CodeTitle</h1>
                        <p class="@Css.Claim.Subtitle">@AppText.Claim.CodeSubtitle</p>
                    </div>
                    <div class="@Css.Claim.CodeRow" @onclick="FocusCodeAsync">
                        @for (int i = 0; i < 6; i++)
                        {
                            <span class="@(i < mCode.Length ? Css.Claim.CodeCellFilled : Css.Claim.CodeCellEmpty)">@(i < mCode.Length ? mCode[i] : ' ')</span>
                        }
                        @* 실제 입력은 투명 오버레이 하나 — 붙여넣기·백스페이스·모바일 키보드가 공짜로 동작한다 *@
                        <input @ref="mCodeInput" class="@Css.Claim.CodeInput" value="@mCode" @oninput="OnCodeInput"
                               maxlength="6" autocomplete="one-time-code" spellcheck="false" aria-label="@AppText.Claim.CodeAriaLabel" />
                    </div>
                    @if (mCodeError is not null)
                    {
                        <span class="@Css.Claim.InlineError">@mCodeError</span>
                    }
                    <button type="button" class="@Css.Claim.OrangeCta" disabled="@mBusy" @onclick="LookupAsync">@AppText.Claim.LookupCta</button>
                    <div class="@Css.Claim.NoCodeSection">
                        <span class="@Css.Claim.NoCodeHead">@AppText.Claim.NoCodeHead</span>
                        <span class="@Css.Claim.NoCodeBody">
                            @AppText.Claim.NoCodeLine1<br />
                            @AppText.Claim.NoCodeLine2Prefix<a href="@Routes.Records" class="font-bold">@AppText.Claim.NoCodeLine2Link</a>@AppText.Claim.NoCodeLine2Suffix<br />
                            @AppText.Claim.NoCodeLine3Prefix<a href="@Routes.PlayerOnboarding" class="font-bold">@AppText.Claim.NoCodeLine3Link</a>
                        </span>
                    </div>
                </div>
            }
            else if (mStep == 1 && mCard is not null)
            {
                @* ── STEP 2: 프로필 확인 ── *@
                <div class="@($"{Css.Claim.Body} gap-4")">
                    <div class="flex flex-col gap-[7px]">
                        <span class="flex items-center gap-1.5">
                            <h1 class="@Css.Claim.Title">@AppText.Claim.ConfirmTitle</h1>
                            @* 서비스 고유 개념 보조 설명 (Design.TooltipHelp §2) *@
                            <InfoPopover Title="@AppText.Claim.InfoTitle">@AppText.Claim.InfoBody</InfoPopover>
                        </span>
                        <p class="@Css.Claim.Subtitle">@AppText.Claim.ConfirmSubtitle(mCard.TeamName)</p>
                    </div>
                    <div class="@Css.Claim.PlayerCard">
                        @* 선수 = 개인 teal (Design.AvatarBadge 유형 색 — dc의 네이비에서 카탈로그로 통일) *@
                        <Avatar Name="@mCard.Name" Size="56" Class="flex-none" />
                        <span class="flex flex-col gap-[3px] flex-1 min-w-0">
                            <span class="text-base font-extrabold text-navy-deep whitespace-nowrap">@mCard.Name</span>
                            @if (PlayerMeta is not null)
                            {
                                <span class="text-[12.5px] text-text-body whitespace-nowrap">@PlayerMeta</span>
                            }
                            <span class="text-xs text-text-muted whitespace-nowrap">@mCard.TeamName</span>
                        </span>
                        <span class="@Css.Claim.UnclaimedBadge">@AppText.Claim.UnclaimedBadge</span>
                    </div>
                    <div class="flex flex-col gap-[9px]">
                        <span class="text-[12.5px] font-extrabold text-text-strong">@AppText.Claim.RelationLabel</span>
                        <div class="flex gap-2">
                            @foreach (SoccerClaimRelation relation in Enum.GetValues<SoccerClaimRelation>().Where(r => r != SoccerClaimRelation.Unknown))
                            {
                                SoccerClaimRelation value = relation;
                                <button type="button"
                                        class="@(mRelation == value ? Css.Claim.RelationButtonActive : Css.Claim.RelationButton)"
                                        @onclick="() => mRelation = value">@value.ToLabel()</button>
                            }
                        </div>
                    </div>
                    <div class="@Css.Claim.InfoBox">
                        @AppText.Claim.ConfirmNoticePrefix<b>@AppText.Claim.ConfirmNoticeBold</b>@AppText.Claim.ConfirmNoticeSuffix
                    </div>
                    <button type="button" class="@Css.Claim.OrangeCta" disabled="@mBusy" @onclick="SendRequestAsync">@AppText.Claim.SendRequestCta</button>
                    <button type="button" class="@Css.Claim.GhostButton" @onclick="() => GoBackTo(0)">@AppText.Claim.NotMyChild</button>
                </div>
            }
            else if (mStep == 2 && mRequest is not null)
            {
                @* ── STEP 3: 승인 대기 ── *@
                <div class="@Css.Claim.BodyCenter">
                    <span class="@Css.Claim.PendingCircle">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-orange"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                    </span>
                    <div class="flex flex-col gap-[7px]">
                        <h1 class="@Css.Claim.TitleCenter">@AppText.Claim.PendingTitle</h1>
                        <p class="@Css.Claim.Subtitle">@AppText.Claim.PendingSubtitleLine1(mRequest.TeamName)<br />@AppText.Claim.PendingSubtitleLine2</p>
                    </div>
                    <div class="@Css.Claim.SummaryCard">
                        <Avatar Name="@mRequest.PlayerName" Size="44" Class="flex-none" />
                        <span class="flex flex-col gap-0.5 flex-1 min-w-0">
                            <span class="text-[13.5px] font-extrabold text-navy-deep whitespace-nowrap">@AppText.Claim.PendingGuardianOf(mRequest.PlayerName, mRequest.Relation.ToLabel())</span>
                            <span class="text-[11.5px] text-text-muted whitespace-nowrap">@AppText.Claim.RequestedAt(RequestedAtText)</span>
                        </span>
                        <span class="@Css.Claim.PendingBadge">@AppText.Claim.PendingBadge</span>
                    </div>
                    @* 요청 취소 (P1) — 철회하면 스텝 ①로 돌아가 다시 요청할 수 있다 *@
                    <button type="button" class="@Css.Claim.GhostButton" disabled="@mBusy" @onclick="CancelRequestAsync">@AppText.Claim.CancelRequest</button>
                </div>
            }
            else if (mStep == 3 && mRequest is not null)
            {
                @* ── STEP 4: 연결 완료 ── *@
                <div class="@Css.Claim.BodyCenter">
                    <span class="@Css.Claim.DoneCircle">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-teal"><path d="M4.5 12.5l5 5 10-11"></path></svg>
                    </span>
                    <div class="flex flex-col gap-[7px]">
                        <h1 class="@Css.Claim.TitleCenter">@AppText.Claim.DoneTitle(mRequest.PlayerName)</h1>
                        <p class="@Css.Claim.Subtitle">@AppText.Claim.DoneSubtitleLine1<br />@AppText.Claim.DoneSubtitleLine2</p>
                    </div>
                    <div class="w-full flex flex-col gap-2 text-left">
                        <button type="button" class="@Css.Claim.NextCard" @onclick="() => Nav.NavigateTo(Routes.PlayerDashboardSection(SoccerPlayerDashboardSection.Profile))">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-navy flex-none"><path d="M12 4v10M8 10l4 4 4-4"></path><path d="M5 19h14"></path></svg>
                            <span class="text-[12.5px] text-text-strong break-keep"><b>@AppText.Claim.DoneTipVisibilityBold</b>@AppText.Claim.DoneTipVisibility</span>
                        </button>
                        <button type="button" class="@Css.Claim.NextCard" @onclick="() => Nav.NavigateTo(Routes.PlayerDashboardSection(SoccerPlayerDashboardSection.Portfolio))">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-navy flex-none"><rect x="3" y="5" width="18" height="14.5" rx="3"></rect><path d="M10 9.5l5 3-5 3z"></path></svg>
                            <span class="text-[12.5px] text-text-strong break-keep"><b>@AppText.Claim.DoneTipVideoBold</b>@AppText.Claim.DoneTipVideo</span>
                        </button>
                    </div>
                    <button type="button" class="@($"{Css.Claim.OrangeCta} w-full")" @onclick="() => Nav.NavigateTo(Routes.PlayerDashboard)">@AppText.Claim.GoPlayerDashboard</button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private static readonly string[] StepLabels = { AppText.Claim.StepCode, AppText.Claim.StepConfirm, AppText.Claim.StepPending, AppText.Claim.StepDone };

    private int mStep;
    private bool mBusy;

    private string mCode = string.Empty;
    private string? mCodeError;
    private ElementReference mCodeInput;

    private ClaimInviteCardResponse? mCard;
    private SoccerClaimRelation mRelation = SoccerClaimRelation.Mother;
    private ClaimRequestSummaryResponse? mRequest;

    private string CurrentPath => "/" + Nav.ToBaseRelativePath(Nav.Uri);

    private string? PlayerMeta
    {
        get
        {
            if (mCard is null)
            {
                return null;
            }

            List<string> parts = new();
            if (mCard.Position != SoccerPosition.Unknown)
            {
                parts.Add(mCard.Position.ToLabel()!);
            }

            if (mCard.JerseyNumber is not null)
            {
                parts.Add(AppText.Claim.JerseyNumber(mCard.JerseyNumber));
            }

            if (mCard.BirthYear is not null)
            {
                parts.Add(AppText.Claim.BirthYear(mCard.BirthYear));
            }

            if (mCard.AgeGroup != SoccerAgeGroup.Unknown)
            {
                parts.Add(mCard.AgeGroup.ToLabel()!);
            }

            return parts.Count > 0 ? string.Join(" · ", parts) : null;
        }
    }

    private string RequestedAtText => mRequest is null
        ? string.Empty
        : $"{mRequest.RequestedAt.ToWallClock():M/d tt h:mm}".Replace("AM", AppText.Claim.Am).Replace("PM", AppText.Claim.Pm);

    protected override async Task OnInitializedAsync()
    {
        // 직접 URL 진입(카톡 링크) 대비 — 인증 상태를 먼저 확정, 게스트는 로그인 왕복
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity is not { IsAuthenticated: true })
        {
            Nav.NavigateTo(Routes.LoginWithReturn(CurrentPath), replace: true);
            return;
        }

        // 재방문 복원 — Pending은 대기, Approved는 완료에서 시작 (Rejected·없음은 스텝 ①)
        ClaimRequestSummaryResponse? existing = await Claims.GetMyRequestAsync();
        if (existing is not null && existing.Status == SoccerClaimRequestStatus.Pending)
        {
            mRequest = existing;
            mStep = 2;
            return;
        }

        if (existing is not null && existing.Status == SoccerClaimRequestStatus.Approved)
        {
            mRequest = existing;
            mStep = 3;
            return;
        }

        // 공개 선수 프로필 "내 아이 프로필 관리하기" 경유 — 코드 없이 슬러그로 진입해 스텝 ②(프로필 확인)로 바로.
        if (!string.IsNullOrWhiteSpace(SlugQuery))
        {
            ClaimLookupResult byslug = await Claims.LookupBySlugAsync(SlugQuery!);
            if (byslug.Card is not null)
            {
                mCard = byslug.Card;
                mIsCodeless = true;
                mStep = 1;
            }
            // 미연결 선수가 아니면(이미 연결됨·없음) 스텝 ①로 남는다 — 코드 입력으로 안내
        }
    }

    /// <summary>공개 선수 프로필 경유 진입 — 슬러그. 있으면 코드 없이 스텝 ②로 간다.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "slug")]
    public string? SlugQuery { get; set; }

    // 슬러그로 진입한 코드 없는 요청 — 제출 시 PlayerId 경로를 쓴다
    private bool mIsCodeless;

    private void OnCodeInput(ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? string.Empty;
        mCode = new string(raw.ToUpperInvariant().Where(char.IsLetterOrDigit).Take(6).ToArray());
        mCodeError = null;
    }

    private async Task FocusCodeAsync()
    {
        await mCodeInput.FocusAsync();
    }

    private async Task LookupAsync()
    {
        if (mCode.Length < 6)
        {
            mCodeError = AppText.Claim.CodeError;
            return;
        }

        mBusy = true;
        ClaimLookupResult result = await Claims.LookupAsync(mCode);
        mBusy = false;

        if (result.Card is not null)
        {
            mCard = result.Card;
            mStep = 1;
            return;
        }

        if (result.IsNetworkError)
        {
            Toasts.ShowError(AppText.Claim.SendFailedToast, AppText.Claim.Retry, LookupAsync);
            return;
        }

        mCodeError = AppText.Claim.CodeError;
    }

    private async Task SendRequestAsync()
    {
        mBusy = true;
        // 코드 없이(공개 프로필 경유) 진입했으면 PlayerId 경로로, 아니면 코드 경로로 생성한다
        ClaimCreateResult result = mIsCodeless && mCard is not null
            ? await Claims.CreateRequestByPlayerAsync(mCard.PlayerId, mRelation)
            : await Claims.CreateRequestAsync(mCode, mRelation);
        mBusy = false;

        if (result.Request is not null)
        {
            mRequest = result.Request;
            mStep = 2;
            return;
        }

        if (result.IsNetworkError)
        {
            Toasts.ShowError(AppText.Claim.SendFailedToast, AppText.Claim.Retry, SendRequestAsync);
            return;
        }

        mStep = 0;
        mCodeError = AppText.Claim.CodeError;
    }

    // 대기 화면에서 요청 철회 (P1) — 확인 후 취소하면 스텝 ①로 돌아가 다시 요청할 수 있다
    private async Task CancelRequestAsync()
    {
        if (mRequest is null)
        {
            return;
        }

        bool ok = await Confirm.ShowAsync(new ConfirmRequest
        {
            Kind = ConfirmKind.Destructive,
            Title = AppText.Claim.CancelTitle,
            Description = AppText.Claim.CancelDescription(mRequest.PlayerName),
            ConfirmLabel = AppText.Claim.CancelConfirmLabel,
            CancelLabel = AppText.Claim.CancelCancelLabel,
        });

        if (!ok)
        {
            return;
        }

        mBusy = true;
        bool canceled = await Claims.CancelRequestAsync(mRequest.RequestId);
        mBusy = false;

        if (!canceled)
        {
            Toasts.ShowError(AppText.Claim.CancelFailedToast, AppText.Claim.Retry, CancelRequestAsync);
            return;
        }

        mRequest = null;
        mCard = null;
        mIsCodeless = false;
        mCode = string.Empty;
        mStep = 0;
        Toasts.ShowSuccess(AppText.Claim.CancelledToast);
    }

    // 완료 스텝 클릭(뒤로) — 입력은 유지된다 (코드·관계 상태 보존). 대기·완료는 서버 상태라 뒤로 없음.
    private void GoBackTo(int step)
    {
        if (mStep <= 1 && step < mStep)
        {
            mStep = step;
        }
    }

    private static string InitialOf(string name)
    {
        return string.IsNullOrEmpty(name) ? "?" : name[^Math.Min(2, name.Length)..][..1];
    }

}

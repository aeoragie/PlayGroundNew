@using PlayGround.Client.Styles

@* 역할 2분할: 팀(다크) / 선수·학부모(라이트) *@
<section id="roles" class="@($"{Css.Landing.Container} pt-16 md:pt-24 [scroll-margin-top:70px] md:[scroll-margin-top:80px]")">
    <SectionHeader Overline="FOR YOU" Title="@AppText.Landing.RolesTitle" />

    <div class="grid md:grid-cols-2 gap-4 md:gap-6">
        <RoleCard IsDark="true"
                  Icon="🏛️"
                  Title="@AppText.Landing.RoleTeamTitle"
                  BodyText="@AppText.Landing.RoleTeamBody"
                  Items="TeamItems"
                  ButtonText="@AppText.Landing.RoleTeamButton" />

        <RoleCard IsDark="false"
                  Icon="⚽"
                  Title="@AppText.Landing.RolePlayerTitle"
                  BodyText="@AppText.Landing.RolePlayerBody"
                  Items="PlayerItems"
                  ButtonText="@AppText.Landing.RolePlayerButton" />
    </div>
</section>

@code {
    private static readonly string[] TeamItems =
    [
        AppText.Landing.RoleTeamItem1,
        AppText.Landing.RoleTeamItem2,
        AppText.Landing.RoleTeamItem3
    ];

    private static readonly string[] PlayerItems =
    [
        AppText.Landing.RolePlayerItem1,
        AppText.Landing.RolePlayerItem2,
        AppText.Landing.RolePlayerItem3
    ];
}

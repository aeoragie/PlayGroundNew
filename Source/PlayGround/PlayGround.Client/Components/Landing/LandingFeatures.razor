@using PlayGround.Client.Styles
@using PlayGround.Client.Services
@using PlayGround.Contracts.Landing
@inject LandingContentClient ContentClient

@* 핵심 기능 3: PC 3컬럼(아이콘 위) / 모바일 세로 스택(아이콘 좌 + 텍스트 우 가로형).
   콘텐츠는 DB에서 로드, 미가용 시 기본 카피로 폴백. *@
<section id="features" class="@($"{Css.Landing.Container} pt-[72px] md:pt-[110px] [scroll-margin-top:70px] md:[scroll-margin-top:80px]")">
    <SectionHeader Overline="CORE" Title="@AppText.Landing.FeaturesTitle" />

    <div class="flex flex-col gap-3.5 md:grid md:grid-cols-3 md:gap-6">
        @foreach (var feature in mFeatures)
        {
            <div class="bg-white border-1.5 border-border rounded-card-xs md:rounded-card-sm px-5 py-[22px] md:px-[30px] md:py-[34px]
                        flex gap-4 items-start md:flex-col md:gap-[13px]">
                <div class="w-[42px] h-[42px] rounded-[11px] text-[20px] md:w-[46px] md:h-[46px] md:rounded-btn-lg md:text-[22px]
                            flex-none bg-navy flex items-center justify-center">@feature.Icon</div>
                <div class="flex flex-col gap-[7px] md:gap-[13px] min-w-0">
                    <CardTitle SizeClass="text-[16.5px] md:text-[19px]">@feature.Title</CardTitle>
                    <CardText>@feature.Body</CardText>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private IReadOnlyList<LandingItemDto> mFeatures = DefaultFeatures;

    protected override async Task OnInitializedAsync()
    {
        var contents = await ContentClient.GetContentsAsync();
        if (contents is { Features.Count: > 0 })
        {
            mFeatures = contents.Features;
        }
    }

    private static readonly LandingItemDto[] DefaultFeatures =
    [
        new() { Icon = "🏠", Title = AppText.Landing.Feature1Title, Body = AppText.Landing.Feature1Body },
        new() { Icon = "📈", Title = AppText.Landing.Feature2Title, Body = AppText.Landing.Feature2Body },
        new() { Icon = "📊", Title = AppText.Landing.Feature3Title, Body = AppText.Landing.Feature3Body }
    ];
}

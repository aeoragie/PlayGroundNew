@* 선수 지원 폼 (Design.Application §2) — PC 중앙 모달 / 모바일 바텀시트 (Css.MatchForm 골격).
   지원 선수(연결된 자녀 중 선택)·희망 포지션(공고 명시 포지션만)·자기소개(선택 500자)·연락처(읽기 전용).
   자녀 미연결이면 폼 대신 "먼저 자녀를 연결해 주세요" 안내 + Claim CTA. 열 때 자녀를 1회 로드한다.
   연락처는 서버 마스킹 원칙대로 실번호를 노출·조회하지 않고 안내 문구만 보여준다. *@
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Player
@using PlayGround.Contracts.Team
@inject PlayerClient Players
@inject TeamClient Teams
@inject ToastService Toasts

@if (IsOpen && Recruitment is not null)
{
    <div class="@Css.MatchForm.Overlay">
        <div class="fixed inset-0" @onclick="CancelAsync"></div>

        <div class="@Css.MatchForm.Card">
            <span class="@Css.MatchForm.GrabBar"></span>

            <div class="@Css.MatchForm.Header">
                <span class="flex flex-col gap-1 min-w-0">
                    <h2 class="@Css.MatchForm.Title">@AppText.Team.ApplyDialogTitle(TeamName)</h2>
                    <span class="@Css.MatchForm.Subtitle">@Recruitment.Title</span>
                </span>
                <button type="button" aria-label="@AppText.Team.Close" class="@Css.MatchForm.CloseButton" @onclick="CancelAsync">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>

            @if (mChildren is null)
            {
                @* 자녀 로딩 — 짧게 지나가는 상태 *@
                <div class="@Css.MatchForm.Body items-center justify-center min-h-[160px]">
                    <span class="w-6 h-6 rounded-full border-[3px] border-border border-t-navy animate-spin"></span>
                </div>
            }
            else if (mChildren.Count == 0)
            {
                @* 자녀 미연결 — 폼 대신 안내 + Claim CTA *@
                <div class="@Css.MatchForm.Body items-center text-center gap-3 py-8">
                    <span class="text-[14.5px] font-extrabold text-navy-deep break-keep">@AppText.Team.ConnectChildFirst</span>
                    <a href="@Routes.Claim" class="flex items-center justify-center h-11 px-6 rounded-[11px] bg-navy hover:bg-navy-deep text-sm font-bold text-white whitespace-nowrap mt-1 no-underline transition-colors">@AppText.Team.ConnectChild</a>
                </div>
            }
            else
            {
                <CascadingValue Value="@mForm" IsFixed="true">
                    <div class="@Css.MatchForm.Body">
                        <SelectField Label="@AppText.Team.ApplyPlayerLabel" TValue="Guid" @bind-Value="mPlayerId"
                                     Options="@ChildOptions" Placeholder="@AppText.Team.ApplyPlayerPlaceholder"
                                     Helper="@AppText.Team.ApplyPlayerHelper"
                                     Validator="@(v => v == Guid.Empty ? AppText.Team.ApplyPlayerError : null)" />

                        @if (HasPositions)
                        {
                            <RadioCards Label="@AppText.Team.DesiredPosition" TValue="SoccerPosition?" @bind-Value="mDesiredPosition"
                                        Options="@PositionOptions"
                                        Helper="@AppText.Team.DesiredPositionHelper"
                                        Validator="@(v => v is null ? AppText.Team.DesiredPositionError : null)" />
                        }

                        <TextField Label="@AppText.Team.Introduction" @bind-Value="mIntroduction" IsOptional="true" Multiline="true" Rows="3"
                                   MaxLength="500" Placeholder="@AppText.Team.IntroductionPlaceholder" />

                        @* 연락처 — 서버 마스킹 원칙대로 실번호는 노출하지 않는다 *@
                        <div class="flex flex-col gap-1.5">
                            <span class="@Css.Form.Label">@AppText.Team.ContactLabel</span>
                            <div class="h-11 rounded-[10px] border-1.5 border-surface-icon bg-surface-soft px-3 flex items-center text-[12.5px] text-text-body">@AppText.Team.ContactValue</div>
                            <span class="@Css.Form.Helper">@AppText.Team.ContactHelper</span>
                        </div>

                        @if (mInlineError is not null)
                        {
                            <span class="@Css.Form.ErrorMessage">@mInlineError</span>
                        }
                    </div>

                    <div class="@Css.MatchForm.Footer">
                        <button type="button" class="@Css.MatchForm.CancelButton" @onclick="CancelAsync">@AppText.Team.Cancel</button>
                        <SubmitButton Label="@AppText.Team.Apply" BusyLabel="@AppText.Team.ApplyBusy" IsBusy="@mSaving" OnClick="SubmitAsync"
                                      Class="@Css.MatchForm.SubmitWidth" />
                    </div>
                </CascadingValue>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public TeamRecruitmentDto? Recruitment { get; set; }

    [Parameter]
    public string TeamName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnApplied { get; set; }

    private readonly FormFieldContext mForm = new();

    private List<ManagedPlayerDto>? mChildren;
    private Guid mPlayerId;
    private SoccerPosition? mDesiredPosition;
    private string? mIntroduction;
    private bool mSaving;
    private bool mLoaded;
    private string? mInlineError;

    private bool HasPositions => Recruitment is { Positions.Count: > 0 };

    private List<SelectOption<Guid>> ChildOptions =>
        (mChildren ?? new()).Select(c => new SelectOption<Guid>(c.PlayerId, c.Name, ChildMeta(c))).ToList();

    private List<SelectOption<SoccerPosition?>> PositionOptions =>
        (Recruitment?.Positions ?? new()).Select(p => new SelectOption<SoccerPosition?>(p, p.ToString())).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen)
        {
            mLoaded = false;
            return;
        }

        if (mLoaded)
        {
            return;
        }

        mLoaded = true;
        mPlayerId = Guid.Empty;
        mDesiredPosition = null;
        mIntroduction = null;
        mSaving = false;
        mInlineError = null;
        mChildren = null;

        ManagedPlayersResponse? response = await Players.GetMyPlayersAsync();
        mChildren = response?.Players ?? new();
    }

    private static string? ChildMeta(ManagedPlayerDto child)
    {
        List<string> parts = new();
        if (child.AgeGroup != SoccerAgeGroup.Unknown)
        {
            parts.Add(child.AgeGroup.ToText()!);
        }

        if (child.Position != SoccerPosition.Unknown)
        {
            parts.Add(child.Position.ToText()!);
        }

        return parts.Count > 0 ? string.Join(" · ", parts) : null;
    }

    private async Task SubmitAsync()
    {
        mInlineError = null;

        if (!await mForm.ValidateAllAsync())
        {
            return;
        }

        var request = new CreateApplicationRequest
        {
            RecruitmentId = Recruitment!.RecruitmentId,
            PlayerId = mPlayerId,
            DesiredPosition = HasPositions ? mDesiredPosition ?? SoccerPosition.Unknown : SoccerPosition.Unknown,
            Introduction = string.IsNullOrWhiteSpace(mIntroduction) ? null : mIntroduction!.Trim(),
        };

        mSaving = true;
        ApplicationSaveResult result = await Teams.ApplyAsync(request);
        mSaving = false;

        if (!result.Success)
        {
            if (result.IsDuplicate)
            {
                mInlineError = AppText.Team.AlreadyAppliedInline;
                return;
            }

            if (result.IsNetworkError)
            {
                Toasts.ShowError(result.Error ?? AppText.Team.ApplyFailedToast, AppText.Team.Retry, SubmitAsync);
                return;
            }

            mInlineError = result.Error ?? AppText.Team.ApplyFailedToast;
            return;
        }

        Toasts.ShowSuccess(AppText.Team.ApplySentToast);
        await CloseAsync();
        await OnApplied.InvokeAsync();
    }

    private Task CancelAsync() => CloseAsync();

    private async Task CloseAsync()
    {
        mLoaded = false;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}

@* 공개 팀 홈 시즌성적 탭 상단 "다가오는 일정"(PC) — 공개 일정만(서버 필터) · 읽기 전용(⋯·＋ 없음) — Design.Schedule.
   정렬 = 다가오는 일정 오름차순 → 최근 종료 일정 최대 3개. 하단 구독 캘린더 링크 복사. *@
@using PlayGround.Client.Models
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Team
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject ToastService Toasts

@if (Rows.Count > 0)
{
    <div class="flex flex-col gap-[18px] mb-8">
        <h2 class="m-0 text-[19px] font-extrabold text-navy-deep">@AppText.Team.ScheduleTitle</h2>

        <div class="flex flex-col gap-3">
            @foreach (ScheduleDto schedule in Rows)
            {
                ScheduleDto item = schedule;
                bool ended = IsEnded(item);
                <div class="@($"bg-white border-1.5 border-border rounded-[14px] px-5 py-4 flex items-center gap-[18px] {(ended ? "opacity-[.55]" : "")}")">
                    <span class="flex flex-col items-center w-[52px] shrink-0">
                        <span class="text-[11.5px] font-bold @WeekdayClass(When(item))">@WeekdayLabel(When(item))</span>
                        <span class="text-[21px] font-extrabold text-navy-deep tabular-nums">@When(item).Day</span>
                    </span>
                    <span class="@TypeClass(TypeOf(item))">@TypeOf(item).ToLabel()</span>
                    <span class="flex flex-col gap-[3px] flex-1 min-w-0">
                        <span class="text-[15px] font-bold text-navy-deep break-keep">@TitleOf(item)</span>
                        <span class="text-[12.5px] text-text-body break-keep">@MetaOf(item, ended)</span>
                    </span>
                    <span class="text-[13px] font-bold text-text-strong whitespace-nowrap">@TimeOf(item)</span>
                </div>
            }
        </div>

        @* 구독 캘린더 — 공개 iCal 피드 링크 복사(토큰 없는 공개 URL) *@
        <div class="bg-white border-1.5 border-border rounded-[14px] px-5 py-4 flex items-center gap-3.5 flex-wrap">
            <span class="w-10 h-10 rounded-[11px] bg-navy/[.08] flex items-center justify-center shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" class="text-navy"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
            </span>
            <span class="flex flex-col gap-0.5 flex-1 min-w-0">
                <span class="text-[14px] font-extrabold text-navy-deep">@AppText.Team.SubscribeCalendar</span>
                <span class="text-[12.5px] text-text-body break-keep">@AppText.Team.SubscribeBody</span>
            </span>
            <button type="button" @onclick="CopyFeedAsync"
                    class="text-[13px] font-bold text-white bg-navy hover:bg-navy-deep rounded-[10px] px-4 py-2.5 whitespace-nowrap border-0 cursor-pointer transition-colors shrink-0">@AppText.Team.CopySubscribeLink</button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string Slug { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public List<ScheduleDto> Schedules { get; set; } = new();

    private static bool IsEnded(ScheduleDto s) => s.StartsAt < SystemTime.Now;

    // 서버가 주는 StartsAt은 UTC 순간이다 — 화면에 쓰는 날짜·요일·시각은 반드시 현지로 되돌린다
    private static DateTime When(ScheduleDto s) => s.StartsAt.ToWallClock();

    // 다가오는 일정 오름차순 → 최근 종료 일정 최대 3개(최근순). 공개 일정만 서버에서 온다.
    private List<ScheduleDto> Rows =>
        Schedules
            .Where(s => !IsEnded(s))
            .OrderBy(s => s.StartsAt)
            .Concat(Schedules
                .Where(IsEnded)
                .OrderByDescending(s => s.StartsAt)
                .Take(3))
            .ToList();

    private async Task CopyFeedAsync()
    {
        // 절대 iCal URL — Google·Apple 캘린더 구독용(토큰 없는 공개 피드)
        string url = Nav.ToAbsoluteUri($"api/soccer/team/{Uri.EscapeDataString(Slug)}/schedule.ics").ToString();
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", url);
        Toasts.ShowSuccess(AppText.Team.CopiedToast);
    }

    private static SoccerScheduleEventType TypeOf(ScheduleDto s) =>
        Enum.TryParse(s.Type, out SoccerScheduleEventType type) ? type : SoccerScheduleEventType.Match;

    // 경기는 "vs {상대}" 파생, 대회·훈련은 제목 그대로
    private static string TitleOf(ScheduleDto s) =>
        TypeOf(s) == SoccerScheduleEventType.Match
            ? $"vs {s.OpponentName}"
            : (s.Title ?? string.Empty);

    private static string TimeOf(ScheduleDto s) => When(s).ToString("HH:mm");

    private static string WeekdayLabel(DateTime dt) =>
        new[] { AppText.Team.DowSun, AppText.Team.DowMon, AppText.Team.DowTue, AppText.Team.DowWed, AppText.Team.DowThu, AppText.Team.DowFri, AppText.Team.DowSat }[(int)dt.DayOfWeek];

    private static string WeekdayClass(DateTime dt) =>
        dt.DayOfWeek == DayOfWeek.Sunday ? "text-weekend-sun" : "text-text-muted";

    // 메타 = 장소 → (종료면 상태). 공개 뷰라 "비공개"는 나오지 않는다.
    private static string MetaOf(ScheduleDto s, bool ended)
    {
        var parts = new List<string> { s.Venue };
        if (ended)
        {
            bool resultLinked = s.HasResult && TypeOf(s) is SoccerScheduleEventType.Match or SoccerScheduleEventType.Tournament;
            parts.Add(resultLinked ? AppText.Team.FinishedWithResult : AppText.Team.Finished);
        }

        return string.Join(" · ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));
    }

    private static string TypeClass(SoccerScheduleEventType type) =>
        "text-xs font-bold rounded-full px-[13px] py-[5px] whitespace-nowrap shrink-0 " + type switch
        {
            SoccerScheduleEventType.Match => "text-white bg-navy",
            SoccerScheduleEventType.Tournament => "text-orange-ink bg-surface-orange-badge",
            _ => "text-teal-ink bg-teal/[.12]",
        };
}

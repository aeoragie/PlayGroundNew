@* 공개 팀 홈 시즌성적 탭 상단 "다가오는 일정"(모바일) — 공개 일정만 · 읽기 전용 — Design.Schedule.
   날짜 38px · 유형 pill+시간 한 줄 · 정렬 = 다가오는 오름차순 → 최근 종료 3개. 하단 구독 링크 복사. *@
@using PlayGround.Client.Models
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Team
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject ToastService Toasts

@if (Rows.Count > 0)
{
    <div class="flex flex-col gap-3 mb-6">
        <h2 class="m-0 text-base font-extrabold text-navy-deep">@AppText.Team.ScheduleTitle</h2>

        @foreach (ScheduleDto schedule in Rows)
        {
            ScheduleDto item = schedule;
            bool ended = IsEnded(item);
            <div class="@($"{Css.Dashboard.Card} rounded-[13px] px-[15px] py-[13px] flex items-center gap-[13px] {(ended ? "opacity-[.55]" : "")}")">
                <span class="flex flex-col items-center w-[38px] shrink-0">
                    <span class="text-[10.5px] font-bold @WeekdayClass(When(item))">@WeekdayLabel(When(item))</span>
                    <span class="text-lg font-extrabold text-navy-deep tabular-nums">@When(item).Day</span>
                </span>
                <span class="flex flex-col gap-[3px] flex-1 min-w-0">
                    <span class="flex items-center gap-[7px]">
                        <span class="@TypeClass(TypeOf(item))">@TypeOf(item).ToLabel()</span>
                        <span class="text-[11.5px] font-bold text-text-strong whitespace-nowrap">@TimeOf(item)</span>
                    </span>
                    <span class="text-[13.5px] font-bold text-navy-deep break-keep">@TitleOf(item)</span>
                    <span class="text-[11.5px] text-text-body break-keep">@MetaOf(item, ended)</span>
                </span>
            </div>
        }

        @* 구독 캘린더 — 공개 iCal 피드 링크 복사 *@
        <div class="@($"{Css.Dashboard.Card} rounded-[13px] px-4 py-3.5 flex flex-col gap-2.5")">
            <span class="flex flex-col gap-0.5">
                <span class="text-[13.5px] font-extrabold text-navy-deep">@AppText.Team.SubscribeCalendar</span>
                <span class="text-[12px] text-text-body break-keep">@AppText.Team.SubscribeBody</span>
            </span>
            <button type="button" @onclick="CopyFeedAsync"
                    class="w-full text-[13px] font-bold text-white bg-navy hover:bg-navy-deep rounded-[10px] py-3 whitespace-nowrap border-0 cursor-pointer transition-colors">@AppText.Team.CopySubscribeLink</button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string Slug { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public List<ScheduleDto> Schedules { get; set; } = new();

    private static bool IsEnded(ScheduleDto s) => s.StartsAt < SystemTime.Now;

    // 서버가 주는 StartsAt은 UTC 순간이다 — 화면에 쓰는 날짜·요일·시각은 반드시 현지로 되돌린다
    private static DateTime When(ScheduleDto s) => s.StartsAt.ToWallClock();

    private List<ScheduleDto> Rows =>
        Schedules
            .Where(s => !IsEnded(s))
            .OrderBy(s => s.StartsAt)
            .Concat(Schedules
                .Where(IsEnded)
                .OrderByDescending(s => s.StartsAt)
                .Take(3))
            .ToList();

    private async Task CopyFeedAsync()
    {
        string url = Nav.ToAbsoluteUri($"api/soccer/team/{Uri.EscapeDataString(Slug)}/schedule.ics").ToString();
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", url);
        Toasts.ShowSuccess(AppText.Team.CopiedToast);
    }

    private static SoccerScheduleType TypeOf(ScheduleDto s) =>
        s.Type;

    private static string TitleOf(ScheduleDto s) =>
        TypeOf(s) == SoccerScheduleType.Match
            ? $"vs {s.OpponentName}"
            : (s.Title ?? string.Empty);

    private static string TimeOf(ScheduleDto s) => When(s).ToString("HH:mm");

    private static string WeekdayLabel(DateTime dt) =>
        new[] { AppText.Team.DowSun, AppText.Team.DowMon, AppText.Team.DowTue, AppText.Team.DowWed, AppText.Team.DowThu, AppText.Team.DowFri, AppText.Team.DowSat }[(int)dt.DayOfWeek];

    private static string WeekdayClass(DateTime dt) =>
        dt.DayOfWeek == DayOfWeek.Sunday ? "text-weekend-sun" : "text-text-muted";

    private static string MetaOf(ScheduleDto s, bool ended)
    {
        var parts = new List<string> { s.Venue };
        if (ended)
        {
            bool resultLinked = s.HasResult && TypeOf(s) is SoccerScheduleType.Match or SoccerScheduleType.Tournament;
            parts.Add(resultLinked ? AppText.Team.FinishedWithResult : AppText.Team.Finished);
        }

        return string.Join(" · ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));
    }

    private static string TypeClass(SoccerScheduleType type) =>
        "text-[10.5px] font-bold rounded-full px-[9px] py-0.5 whitespace-nowrap shrink-0 " + type switch
        {
            SoccerScheduleType.Match => "text-white bg-navy",
            SoccerScheduleType.Tournament => "text-orange-ink bg-surface-orange-badge",
            _ => "text-teal-ink bg-teal/[.12]",
        };
}

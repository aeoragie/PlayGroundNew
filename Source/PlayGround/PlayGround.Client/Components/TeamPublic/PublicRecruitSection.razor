@* 모집 탭(PC): 모집중 공고 카드 + 마감 공고(회색 .75) + 문의 카드 — SPEC.TEAMPUBLICHOME §④
   "지원하기"(네이비)는 지원 폼을 연다(게스트는 상위가 로그인으로 보냄). 정원 충족=모집 마감(비활성),
   기지원=지원 완료·상태 보기(네이비 아웃라인). "입단 문의 남기기"는 문의 플로우 미구현이라 무동작. *@
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Team

<div class="flex flex-col gap-4">
    <h2 class="m-0 text-[19px] font-extrabold text-navy-deep">@AppText.Team.RecruitTitle</h2>

    @if (Data.Items.Count > 0)
    {
        <div class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] gap-3.5">
            @foreach (TeamRecruitmentDto item in Data.Items)
            {
                @if (item.IsOpen)
                {
                    <div class="bg-white border-1.5 border-border rounded-2xl p-[26px] flex flex-col gap-3">
                        <div class="flex items-center gap-[9px]">
                            <span class="text-[16.5px] font-extrabold text-navy-deep">@item.Title</span>
                            <span class="@Css.Badge.Pending">@AppText.Team.Recruiting</span>
                        </div>
                        <p class="m-0 text-[13.5px] text-text-body leading-[1.7] break-keep">@item.Description</p>
                        @if (item.Conditions.Count > 0 || item.DeadlineAt is not null)
                        {
                            <div class="flex gap-2 flex-wrap">
                                @foreach (string condition in item.Conditions)
                                {
                                    <span class="text-xs font-bold text-text-strong bg-surface-icon rounded-full px-3 py-1 whitespace-nowrap">@condition</span>
                                }
                                @if (item.DeadlineAt is not null)
                                {
                                    <span class="text-xs font-bold text-text-strong bg-surface-icon rounded-full px-3 py-1 whitespace-nowrap">@AppText.Team.Deadline(DeadlineText(item))</span>
                                }
                            </div>
                        }
                        @if (AppliedRecruitmentIds.Contains(item.RecruitmentId))
                        {
                            <a href="@Routes.Dashboard" class="flex items-center justify-center h-11 rounded-[11px] border-1.5 border-navy bg-white text-sm font-bold text-navy whitespace-nowrap mt-1 no-underline hover:bg-navy hover:text-white transition-colors">@AppText.Team.AppliedStatus</a>
                        }
                        else if (IsFull(item))
                        {
                            <button type="button" disabled class="flex items-center justify-center h-11 rounded-[11px] bg-surface-icon text-sm font-bold text-text-muted whitespace-nowrap mt-1 border-0 cursor-not-allowed">@AppText.Team.RecruitClosed</button>
                        }
                        else
                        {
                            <button type="button" @onclick="() => OnApply.InvokeAsync(item)" class="flex items-center justify-center h-11 rounded-[11px] bg-navy hover:bg-navy-deep text-sm font-bold text-white whitespace-nowrap mt-1 border-0 cursor-pointer transition-colors">@AppText.Team.Apply</button>
                        }
                    </div>
                }
                else
                {
                    <div class="bg-surface-soft border-1.5 border-border rounded-2xl p-[26px] flex flex-col gap-3 opacity-75">
                        <div class="flex items-center gap-[9px]">
                            <span class="text-[16.5px] font-extrabold text-navy-deep">@item.Title</span>
                            <span class="@Css.Badge.Neutral">@AppText.Team.Closed</span>
                        </div>
                        <p class="m-0 text-[13.5px] text-text-body leading-[1.7] break-keep">@item.Description</p>
                    </div>
                }
            }
        </div>
    }

    <div class="bg-white border-1.5 border-border rounded-2xl p-[26px] flex items-center gap-[18px] flex-wrap">
        <span class="flex flex-col gap-[3px] flex-1 min-w-[260px]">
            <span class="text-[15px] font-extrabold text-navy-deep break-keep">@AppText.Team.InquiryTitle</span>
            <span class="text-[13px] text-text-body break-keep">@AppText.Team.InquiryBody</span>
        </span>
        <button type="button" class="flex items-center h-11 px-6 border-1.5 border-navy rounded-[11px] bg-white text-[13.5px] font-bold text-navy whitespace-nowrap cursor-pointer hover:bg-navy hover:text-white transition-colors">@AppText.Team.InquiryCta</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TeamRecruitmentsResponse Data { get; set; } = new();

    /// <summary>내가 이미 지원한 공고 Id — 지원 완료 상태로 렌더한다(로그인 시에만 채워짐).</summary>
    [Parameter]
    public HashSet<Guid> AppliedRecruitmentIds { get; set; } = new();

    /// <summary>"지원하기" 클릭 — 상위가 게스트면 로그인, 로그인 상태면 지원 폼을 연다.</summary>
    [Parameter]
    public EventCallback<TeamRecruitmentDto> OnApply { get; set; }

    internal static string DeadlineText(TeamRecruitmentDto item) =>
        item.DeadlineAt is null ? string.Empty : item.DeadlineAt.Value.Format("M/d");

    /// <summary>정원 충족 — Capacity가 있고 수락 수가 정원 이상이면 지원 차단(모집 마감).</summary>
    internal static bool IsFull(TeamRecruitmentDto item) =>
        item.Capacity is int cap && item.AcceptedCount >= cap;
}

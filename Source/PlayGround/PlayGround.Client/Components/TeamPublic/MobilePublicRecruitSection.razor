@* 모집 탭(모바일): 카드 세로 스택 — 문의 카드는 버튼 없이 문장으로 종료 (레퍼런스 그대로,
   입단 문의는 하단 고정 오렌지 CTA가 담당). "지원하기"(네이비)는 지원 폼을 연다(게스트는 상위가 로그인).
   정원 충족=모집 마감(비활성), 기지원=지원 완료·상태 보기(네이비 아웃라인). *@
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Team

<div class="flex flex-col gap-3">
    <h2 class="m-0 text-base font-extrabold text-navy-deep">선수 모집</h2>

    @foreach (TeamRecruitmentDto item in Data.Items)
    {
        @if (item.IsOpen)
        {
            <div class="bg-white border-1.5 border-border rounded-[15px] p-5 flex flex-col gap-[11px]">
                <div class="flex items-center gap-2">
                    <span class="text-[15px] font-extrabold text-navy-deep">@item.Title</span>
                    <span class="@Css.Badge.Pending">모집중</span>
                </div>
                <p class="m-0 text-[12.5px] text-text-body leading-[1.65] break-keep">@item.Description</p>
                @if (item.Conditions.Count > 0 || item.DeadlineDate is not null)
                {
                    <div class="flex gap-[7px] flex-wrap">
                        @foreach (string condition in item.Conditions)
                        {
                            <span class="text-[11px] font-bold text-text-strong bg-surface-icon rounded-full px-2.5 py-[3px] whitespace-nowrap">@condition</span>
                        }
                        @if (item.DeadlineDate is not null)
                        {
                            <span class="text-[11px] font-bold text-text-strong bg-surface-icon rounded-full px-2.5 py-[3px] whitespace-nowrap">마감 @PublicRecruitSection.DeadlineText(item)</span>
                        }
                    </div>
                }
                @if (AppliedRecruitmentIds.Contains(item.RecruitmentId))
                {
                    <a href="@Routes.Dashboard" class="flex items-center justify-center h-11 rounded-[11px] border-1.5 border-navy bg-white text-[13.5px] font-bold text-navy whitespace-nowrap no-underline">지원 완료 · 상태 보기</a>
                }
                else if (PublicRecruitSection.IsFull(item))
                {
                    <button type="button" disabled class="flex items-center justify-center h-11 rounded-[11px] bg-surface-icon text-[13.5px] font-bold text-text-muted whitespace-nowrap border-0 cursor-not-allowed">모집 마감</button>
                }
                else
                {
                    <button type="button" @onclick="() => OnApply.InvokeAsync(item)" class="flex items-center justify-center h-11 rounded-[11px] bg-navy text-[13.5px] font-bold text-white whitespace-nowrap border-0 cursor-pointer">지원하기</button>
                }
            </div>
        }
        else
        {
            <div class="bg-surface-soft border-1.5 border-border rounded-[15px] p-5 flex flex-col gap-2 opacity-75">
                <div class="flex items-center gap-2">
                    <span class="text-[15px] font-extrabold text-navy-deep">@item.Title</span>
                    <span class="@Css.Badge.Neutral">마감</span>
                </div>
                <p class="m-0 text-[12.5px] text-text-body leading-[1.65] break-keep">@item.Description</p>
            </div>
        }
    }

    <div class="bg-white border-1.5 border-border rounded-[15px] p-5 flex flex-col gap-2">
        <span class="text-sm font-extrabold text-navy-deep break-keep">모집 공고가 없어도 문의할 수 있어요</span>
        <span class="text-[12.5px] text-text-body break-keep">연령·포지션을 남겨주시면 자리가 생길 때 연락드립니다.</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TeamRecruitmentsResponse Data { get; set; } = new();

    /// <summary>내가 이미 지원한 공고 Id — 지원 완료 상태로 렌더한다(로그인 시에만 채워짐).</summary>
    [Parameter]
    public HashSet<Guid> AppliedRecruitmentIds { get; set; } = new();

    /// <summary>"지원하기" 클릭 — 상위가 게스트면 로그인, 로그인 상태면 지원 폼을 연다.</summary>
    [Parameter]
    public EventCallback<TeamRecruitmentDto> OnApply { get; set; }
}

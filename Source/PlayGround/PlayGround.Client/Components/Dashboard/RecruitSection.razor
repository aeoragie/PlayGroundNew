@* 선수 모집 섹션(PC): 공고 카드 + 작성·수정·마감·삭제 — SPEC.TEAMDASHBOARD §6의 공고 관리 부분.
   공고 카드 아래에 지원자 리스트(ApplicantList)를 얹는다 — 새 섹션이 아니라 같은 자리의 확장(Design.Application §3).
   삭제 = 소프트 + 실행취소 토스트(B3 규칙), 마감 = 단방향(재오픈 없음 — 확인 모달에 명시). *@
@using PlayGround.Client.Components.TeamPublic
@using PlayGround.Client.Styles
@using PlayGround.Client.Services.Feedback
@using PlayGround.Contracts.Team
@inject TeamClient Teams
@inject ToastService Toasts
@inject ConfirmService Confirm

<div class="flex flex-col gap-[18px]">
    <div class="flex justify-between items-center">
        <h1 class="@Css.Dashboard.SectionTitle">@AppText.Dashboard.RecruitTitle</h1>
        <button type="button" class="@Css.Dashboard.PrimaryButton" @onclick="OpenCreate">@AppText.Dashboard.AddRecruit</button>
    </div>

    @if (Data.Items.Count == 0)
    {
        <EmptyState Kind="EmptyState.Art.Players" Title="@AppText.Dashboard.RecruitEmptyTitle">
            <Description>@AppText.Dashboard.RecruitEmptyBody</Description>
        </EmptyState>
    }
    else
    {
        <div class="grid grid-cols-2 gap-3.5">
            @foreach (TeamRecruitmentDto item in Data.Items)
            {
                <div class="@($"{Css.Dashboard.Card} rounded-[14px] px-[22px] py-5 flex flex-col gap-2.5 {(item.IsOpen ? "" : "opacity-65")}")">
                    <div class="flex items-center gap-2.5">
                        <span class="text-[15.5px] font-extrabold text-navy-deep">@item.Title</span>
                        @if (item.IsOpen)
                        {
                            <span class="@Css.Badge.Pending">@AppText.Dashboard.Recruiting</span>
                        }
                        else
                        {
                            <span class="@Css.Badge.Neutral">@AppText.Dashboard.Closed</span>
                        }
                        <div class="flex-1"></div>
                        <OverflowMenu Target="@item.Title"
                                      Items="@MenuItemsOf(item)"
                                      DestructiveItems="@DestructiveItemsOf(item)" />
                    </div>
                    <span class="text-[13px] text-text-body leading-[1.6] break-keep">@item.Description</span>
                    @if (MetaOf(item) is string meta)
                    {
                        <span class="text-[12.5px] text-text-muted whitespace-nowrap">@meta</span>
                    }
                </div>
            }
        </div>
    }

    @* 지원자 리스트 — 공고 카드 아래 같은 자리에 확장 (Design.Application §3) *@
    <ApplicantList Applications="@Applicants" OnChanged="OnApplicantsChanged" />

    <RecruitmentFormDialog @bind-IsOpen="mFormOpen" Editing="@mEditing" OnSaved="OnChangedAsync" />
</div>

@code {
    [Parameter, EditorRequired]
    public TeamRecruitmentsResponse Data { get; set; } = new();

    /// <summary>저장·마감·삭제 후 — 부모가 목록을 다시 불러온다.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>이 팀 공고들의 지원자 전부(최신순) — 상태별 세그먼트로 나눠 렌더한다.</summary>
    [Parameter]
    public List<ApplicationDto> Applicants { get; set; } = new();

    /// <summary>지원 상태 전환 후 — 부모가 지원자 목록을 다시 불러온다.</summary>
    [Parameter]
    public EventCallback OnApplicantsChanged { get; set; }

    private bool mFormOpen;
    private TeamRecruitmentDto? mEditing;

    // 마감 공고는 수정·마감이 없다 — 삭제만 (수정할 수 없는 상태라 항목 자체가 없다)
    private List<OverflowMenu.MenuItem> MenuItemsOf(TeamRecruitmentDto item) =>
        item.IsOpen
            ? new List<OverflowMenu.MenuItem>
            {
                new(AppText.Dashboard.Edit, () => { OpenEdit(item); return Task.CompletedTask; }),
                new(AppText.Dashboard.CloseRecruit, () => CloseAsync(item)),
            }
            : new List<OverflowMenu.MenuItem>();

    private List<OverflowMenu.MenuItem> DestructiveItemsOf(TeamRecruitmentDto item) =>
        new() { new(AppText.Dashboard.Delete, () => DeleteAsync(item)) };

    internal static string? MetaOf(TeamRecruitmentDto item)
    {
        // "지원 n"은 지원 스키마 도입 전이라 넣지 않는다 — 마감일만
        return item.DeadlineDate is null ? null : AppText.Dashboard.DeadlineLabel(PublicRecruitSection.DeadlineText(item));
    }

    private void OpenCreate()
    {
        mEditing = null;
        mFormOpen = true;
    }

    private void OpenEdit(TeamRecruitmentDto item)
    {
        mEditing = item;
        mFormOpen = true;
    }

    private async Task CloseAsync(TeamRecruitmentDto item)
    {
        // 마감은 되돌릴 수 없다(재오픈 없음) — 사전 확인에 그 사실을 명시한다
        bool confirmed = await Confirm.ShowAsync(new ConfirmRequest
        {
            Kind = ConfirmKind.Normal,
            Title = AppText.Dashboard.CloseRecruitTitle(item.Title),
            Description = AppText.Dashboard.CloseRecruitDescription,
            ConfirmLabel = AppText.Dashboard.CloseRecruit,
        });

        if (!confirmed)
        {
            return;
        }

        if (await Teams.CloseRecruitmentAsync(item.RecruitmentId))
        {
            Toasts.ShowSuccess(AppText.Dashboard.RecruitClosedToast);
            await OnChangedAsync();
            return;
        }

        Toasts.ShowError(AppText.Dashboard.RecruitCloseFailedToast);
    }

    private async Task DeleteAsync(TeamRecruitmentDto item)
    {
        bool confirmed = await Confirm.ShowAsync(new ConfirmRequest
        {
            Kind = ConfirmKind.Destructive,
            Title = AppText.Dashboard.DeleteRecruitTitle(item.Title),
            Description = AppText.Dashboard.GoneFromPublicHome,
            ConfirmLabel = AppText.Dashboard.Delete,
        });

        if (!confirmed)
        {
            return;
        }

        if (await Teams.DeleteRecruitmentAsync(item.RecruitmentId))
        {
            Toasts.ShowSuccess(AppText.Dashboard.RecruitDeletedToast, AppText.Dashboard.Undo, () => RestoreAsync(item));
            await OnChangedAsync();
            return;
        }

        Toasts.ShowError(AppText.Dashboard.RecruitDeleteFailedToast);
    }

    private async Task RestoreAsync(TeamRecruitmentDto item)
    {
        if (await Teams.DeleteRecruitmentAsync(item.RecruitmentId, restore: true))
        {
            await OnChangedAsync();
            return;
        }

        Toasts.ShowError("공고를 복구하지 못했어요.");
    }

    private async Task OnChangedAsync()
    {
        await OnChanged.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }
}

@* 초대코드로 팀 연결 카드 — 소속팀 없는 선수 프로필에서 노출. 성공 시 승격 토큰 교체 후 부모에 재로드 통지 *@
@using PlayGround.Client.Styles
@inject PlayerClient Players
@inject JwtAuthenticationStateProvider AuthProvider
@inject ToastService Toasts

<div class="@($"{Css.Dashboard.Card} p-[18px] md:p-[22px] flex flex-col gap-3")">
    <div class="flex flex-col gap-1">
        <span class="text-sm md:text-[15px] font-extrabold text-navy-deep">@AppText.Player.ClaimTitle</span>
        <span class="text-xs text-text-muted leading-[1.6] break-keep">@AppText.Player.ClaimBody</span>
    </div>
    <div class="flex gap-2">
        <input class="flex-1 min-w-0 h-[42px] px-3.5 border-1.5 border-border rounded-[10px] text-sm font-bold text-navy-deep uppercase tracking-[.08em] placeholder:normal-case placeholder:font-normal placeholder:tracking-normal placeholder:text-text-faint focus:border-navy outline-none"
               placeholder="@AppText.Player.ClaimPlaceholder" maxlength="12" @bind="mCode" @bind:event="oninput" @onkeydown="OnKeyDown" />
        <button type="button" disabled="@mBusy" @onclick="SubmitAsync"
                class="h-[42px] px-[18px] rounded-[10px] bg-navy hover:bg-navy-deep text-[13px] font-bold text-white whitespace-nowrap border-0 cursor-pointer transition-colors disabled:opacity-60">@(mBusy ? AppText.Player.ClaimBusy : AppText.Player.ClaimSubmit)</button>
    </div>
    @if (mError is not null)
    {
        <span role="alert" class="text-xs text-danger break-keep">@mError</span>
    }

    @* 무소속 선수의 팀 탐색 진입 (Design.Navigation 7/21 보강 ②) — 이 카드 자체가 무소속일 때만 뜬다 *@
    <div class="border-t border-dashed border-border pt-3 flex items-center gap-2.5">
        <span class="text-xs text-text-muted break-keep flex-1">@AppText.Player.ClaimNoCode</span>
        <a href="@Routes.TeamExplore"
           class="h-9 px-3.5 flex items-center rounded-[9px] bg-navy hover:bg-navy-deep text-xs font-bold text-white whitespace-nowrap transition-colors">@AppText.Player.ClaimFindTeam</a>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnClaimed { get; set; }

    private string mCode = string.Empty;
    private string? mError;
    private bool mBusy;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitAsync();
        }
    }

    private async Task SubmitAsync()
    {
        mError = null;

        if (string.IsNullOrWhiteSpace(mCode))
        {
            mError = AppText.Player.ClaimErrorEmpty;
            return;
        }

        mBusy = true;
        PlayerClaimResult result = await Players.ClaimInviteAsync(mCode.Trim());
        mBusy = false;

        if (!result.Success)
        {
            // 코드 오류는 입력 문제 → 인라인. 요청 실패는 시스템 오류 → 토스트 + 재시도
            if (result.IsNetworkError)
            {
                Toasts.ShowError(result.Error ?? AppText.Player.ClaimFailedToast, AppText.Player.Retry, SubmitAsync);
            }
            else
            {
                mError = result.Error;
            }

            return;
        }

        // General → Player 승격 시 새 토큰으로 교체 (재로그인 불필요)
        if (result.AccessToken is not null)
        {
            await AuthProvider.MarkUserAuthenticatedAsync(result.AccessToken);
        }

        Toasts.ShowSuccess(result.TeamName is not null ? AppText.Player.ClaimLinkedToast(result.TeamName) : AppText.Player.ClaimLinkedFallback);
        await OnClaimed.InvokeAsync();
    }
}

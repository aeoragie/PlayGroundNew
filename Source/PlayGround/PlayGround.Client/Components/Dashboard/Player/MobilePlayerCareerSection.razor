@* 커리어(모바일): 타임라인 — 검증 뱃지는 본문 하단 배치 — SPEC.PLAYERDASHBOARD.md §2
   이력이 없으면 현재 상태 + 등록 가이드 안내 *@
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Player

<div class="flex flex-col gap-3">
    <div class="flex justify-between items-center">
        <h1 class="m-0 text-[19px] font-extrabold text-navy-deep">@AppText.Player.CareerTitle</h1>
        <button type="button" class="@Css.Dashboard.MobilePrimaryButton" @onclick="OnAdd">@AppText.Player.AddCareer</button>
    </div>

    @if (Entries.Count == 0)
    {
        @* 빈 상태 Tier A (주 액션은 헤더의 ＋ 이력 추가 하나 유지 — 카드 안 CTA 없음) *@
        <EmptyState Kind="EmptyState.Art.Record" Title="@AppText.Player.CareerEmptyTitle">
            <Description>@AppText.Player.CareerEmptyBody1<br />@AppText.Player.CareerEmptyBody2</Description>
        </EmptyState>
    }

    @if (Entries.Count > 0)
    {
        <div class="@($"{Css.Dashboard.Card} rounded-[15px] p-[18px] flex flex-col")">
            @foreach (PlayerCareerEntryDto entry in Entries)
            {
                <div class="flex gap-[13px] py-[13px] border-b border-surface-icon">
                    <span class="flex flex-col items-center shrink-0 w-3.5">
                        <span class="@($"w-3 h-3 rounded-full shrink-0 mt-1 {(entry.IsCurrent ? "bg-teal" : "bg-border")}")"></span>
                        <span class="w-0.5 flex-1 bg-border mt-1"></span>
                    </span>
                    <span class="flex flex-col gap-1 flex-1 min-w-0 pb-1">
                        <span class="flex items-center gap-[7px] flex-wrap">
                            <span class="text-sm font-extrabold text-navy-deep break-keep">@entry.TeamName</span>
                            @if (entry.IsCurrent)
                            {
                                <span class="@Css.Badge.Positive">@AppText.Player.CurrentTeam</span>
                            }
                            @if (entry.BadgeLabel is not null)
                            {
                                <span class="@Css.Badge.Pending">@entry.BadgeLabel</span>
                            }
                        </span>
                        <span class="text-[11.5px] text-text-body whitespace-nowrap">@PlayerCareerSection.MetaLine(entry)</span>
                        @if (entry.Note is not null)
                        {
                            <span class="text-xs text-text-body leading-[1.6] break-keep">@entry.Note</span>
                        }
                        <span class="@PlayerCareerSection.VerifyClass(entry.IsVerified)">@(entry.IsVerified ? AppText.Player.VerifiedByTeam : AppText.Player.SelfEntered)</span>
                    </span>
                    <OverflowMenu Target="@entry.TeamName"
                                  Items="@BuildMenuItems(entry)" DestructiveItems="@BuildDestructiveItems(entry)" />
                </div>
            }
            <span class="text-[11px] text-text-muted pt-3 break-keep">@AppText.Player.CareerFootnoteShort</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<PlayerCareerEntryDto> Entries { get; set; } = new();

    [Parameter]
    public EventCallback OnAdd { get; set; }

    [Parameter]
    public EventCallback<PlayerCareerEntryDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<PlayerCareerEntryDto> OnDelete { get; set; }

    private List<OverflowMenu.MenuItem> BuildMenuItems(PlayerCareerEntryDto entry) => new()
    {
        new OverflowMenu.MenuItem(AppText.Player.EditCareer, () => OnEdit.InvokeAsync(entry)),
    };

    private List<OverflowMenu.MenuItem> BuildDestructiveItems(PlayerCareerEntryDto entry) => new()
    {
        new OverflowMenu.MenuItem(AppText.Player.DeleteCareer, () => OnDelete.InvokeAsync(entry)),
    };
}

@* 선수 프로필 수치 편집 (키·몸무게·주발·학교) — PC 중앙 모달 / 모바일 전체 시트.
   폼이 전체 상태를 보내므로 비운 값은 서버에서 지워진다(항목 삭제 = 빈 값 저장).
   검증 오류는 인라인만(토스트 금지), 저장 실패만 토스트. 저장 후 상위가 프로필을 다시 읽는다. *@
@using System.Text.RegularExpressions
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Player
@inject PlayerClient Players
@inject ToastService Toasts

@if (IsOpen)
{
    <div class="@Css.MatchForm.Overlay">
        <div class="fixed inset-0" @onclick="CancelAsync"></div>

        <div class="@Css.MatchForm.Card">
            <span class="@Css.MatchForm.GrabBar"></span>

            <div class="@Css.MatchForm.Header">
                <h2 class="@Css.MatchForm.Title">프로필 수정</h2>
                <button type="button" aria-label="닫기" class="@Css.MatchForm.CloseButton" @onclick="CancelAsync">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>

            <CascadingValue Value="@mForm" IsFixed="true">
                <div class="@Css.MatchForm.Body">
                    <div class="@Css.MatchForm.DateTimeRow">
                        <TextField Label="키 (cm)" @bind-Value="mHeightText" IsOptional="true"
                                   Validator="ValidateHeight" Placeholder="168" MaxLength="3" />
                        <TextField Label="몸무게 (kg)" @bind-Value="mWeightText" IsOptional="true"
                                   Validator="ValidateWeight" Placeholder="58" MaxLength="3" />
                    </div>

                    <SelectField TValue="string" Label="주발" @bind-Value="mFoot" IsOptional="true"
                                 Options="@FootOptions" Placeholder="선택" />

                    <TextField Label="학교" @bind-Value="mSchool" IsOptional="true"
                               Placeholder="예: 서울중학교" MaxLength="100"
                               Helper="공개 범위 설정에서 학교 공개를 켜야 다른 사람에게 보여요." />

                    <TextField Label="프로필 주소" @bind-Value="mSlug" Validator="ValidateSlug"
                               Placeholder="gangmin" MaxLength="30"
                               Helper="@SlugHelper" />
                </div>

                <div class="@Css.MatchForm.Footer">
                    <button type="button" class="@Css.MatchForm.CancelButton" @onclick="CancelAsync">취소</button>
                    <SubmitButton Label="저장" BusyLabel="저장 중…" IsBusy="@mSaving" OnClick="SubmitAsync"
                                  Class="@Css.MatchForm.SubmitWidth" />
                </div>
            </CascadingValue>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>편집 대상 자녀 — 보호자가 자녀를 여러 명 관리할 수 있다.</summary>
    [Parameter]
    public Guid? PlayerId { get; set; }

    /// <summary>현재 프로필 — 열 때 초기값을 채운다.</summary>
    [Parameter]
    public PlayerProfileDto? Profile { get; set; }

    /// <summary>저장 성공 후 상위(페이지)가 프로필을 다시 읽는다.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    private static readonly List<SelectOption<string>> FootOptions = new()
    {
        new SelectOption<string>("Left", "왼발"),
        new SelectOption<string>("Right", "오른발"),
        new SelectOption<string>("Both", "양발"),
    };

    // 소문자 영숫자, 하이픈 허용(양끝·연속 하이픈 금지) — 서버 규칙과 같다.
    private static readonly Regex SlugRegex = new(@"^[a-z0-9]+(-[a-z0-9]+)*$", RegexOptions.Compiled);

    // 예약어 — 서버(SoccerPlayerProfileInfoUpdateCommand)와 같은 목록.
    private static readonly HashSet<string> Reserved = new(StringComparer.OrdinalIgnoreCase)
    {
        "me", "api", "admin", "new", "edit", "player", "team", "teams",
        "settings", "dashboard", "card", "login", "records", "claim"
    };

    private readonly FormFieldContext mForm = new();

    private string? mHeightText;
    private string? mWeightText;
    private string? mFoot;
    private string? mSchool;
    private string? mSlug;
    private string? mTakenSlug; // 서버가 "이미 사용 중"이라고 돌려준 값 — 인라인 오류 표시용
    private bool mSaving;
    private bool mLoaded;

    private string SlugHelper => $"공개 프로필 주소: /player/{(string.IsNullOrWhiteSpace(mSlug) ? "…" : mSlug.Trim().ToLowerInvariant())}";

    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            mLoaded = false;
            return;
        }

        if (mLoaded)
        {
            return;
        }

        mLoaded = true;
        mHeightText = Profile?.HeightCm?.ToString();
        mWeightText = Profile?.WeightKg?.ToString();
        mFoot = Profile?.PreferredFoot;
        mSchool = Profile?.SchoolName;
        mSlug = Profile?.Slug;
        mTakenSlug = null;
    }

    private string? ValidateSlug(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "프로필 주소를 입력해 주세요.";
        }

        string v = value.Trim().ToLowerInvariant();
        if (v.Length < 3 || v.Length > 30)
        {
            return "3~30자로 입력해 주세요.";
        }

        if (!SlugRegex.IsMatch(v))
        {
            return "소문자 영문·숫자·하이픈(-)만 쓸 수 있어요.";
        }

        if (Reserved.Contains(v))
        {
            return "사용할 수 없는 주소예요.";
        }

        if (mTakenSlug is not null && string.Equals(v, mTakenSlug, StringComparison.Ordinal))
        {
            return "이미 사용 중인 주소예요.";
        }

        return null;
    }

    private static string? ValidateHeight(string? value) => ValidateRange(value, 100, 230, "키");

    private static string? ValidateWeight(string? value) => ValidateRange(value, 20, 150, "몸무게");

    private static string? ValidateRange(string? value, int min, int max, string label)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null; // 선택 항목 — 비워두면 지운다
        }

        if (!int.TryParse(value.Trim(), out int n))
        {
            return $"{label}는 숫자로 입력해 주세요.";
        }

        if (n < min || n > max)
        {
            return $"{label}는 {min}~{max} 사이로 입력해 주세요.";
        }

        return null;
    }

    private async Task SubmitAsync()
    {
        if (!await mForm.ValidateAllAsync())
        {
            return;
        }

        var request = new UpdatePlayerProfileInfoRequest
        {
            HeightCm = ParseIntOrNull(mHeightText),
            WeightKg = ParseIntOrNull(mWeightText),
            PreferredFoot = string.IsNullOrWhiteSpace(mFoot) ? null : mFoot,
            SchoolName = string.IsNullOrWhiteSpace(mSchool) ? null : mSchool.Trim(),
            Slug = string.IsNullOrWhiteSpace(mSlug) ? null : mSlug.Trim().ToLowerInvariant(),
        };

        mSaving = true;
        ProfileInfoSaveOutcome outcome = await Players.UpdateProfileInfoAsync(request, PlayerId);
        mSaving = false;

        // 주소만 중복 — 수치는 저장됐다. 다이얼로그를 닫지 않고 주소 필드에 인라인 오류를 띄운다.
        if (outcome == ProfileInfoSaveOutcome.SlugTaken)
        {
            mTakenSlug = request.Slug;
            await mForm.ValidateAllAsync();
            return;
        }

        if (outcome == ProfileInfoSaveOutcome.Failed)
        {
            Toasts.ShowError("저장하지 못했어요. 잠시 후 다시 시도해 주세요.", "재시도", SubmitAsync);
            return;
        }

        Toasts.ShowSuccess("프로필을 수정했어요.");
        await CloseAsync();
        await OnSaved.InvokeAsync();
    }

    private static int? ParseIntOrNull(string? text) =>
        int.TryParse(text?.Trim(), out int n) ? n : null;

    private Task CancelAsync() => CloseAsync();

    private async Task CloseAsync()
    {
        mLoaded = false;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}

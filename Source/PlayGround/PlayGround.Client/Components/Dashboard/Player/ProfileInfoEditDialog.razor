@* 선수 프로필 수치 편집 (키·몸무게·주발·학교) — PC 중앙 모달 / 모바일 전체 시트.
   폼이 전체 상태를 보내므로 비운 값은 서버에서 지워진다(항목 삭제 = 빈 값 저장).
   검증 오류는 인라인만(토스트 금지), 저장 실패만 토스트. 저장 후 상위가 프로필을 다시 읽는다. *@
@using System.Text.RegularExpressions
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Player
@inject PlayerClient Players
@inject ToastService Toasts

@if (IsOpen)
{
    <div class="@Css.MatchForm.Overlay">
        <div class="fixed inset-0" @onclick="CancelAsync"></div>

        <div class="@Css.MatchForm.Card">
            <span class="@Css.MatchForm.GrabBar"></span>

            <div class="@Css.MatchForm.Header">
                <h2 class="@Css.MatchForm.Title">@AppText.Player.EditProfile</h2>
                <button type="button" aria-label="@AppText.Player.Close" class="@Css.MatchForm.CloseButton" @onclick="CancelAsync">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>

            <CascadingValue Value="@mForm" IsFixed="true">
                <div class="@Css.MatchForm.Body">
                    <div class="@Css.MatchForm.DateTimeRow">
                        <TextField Label="@AppText.Player.HeightLabel" @bind-Value="mHeightText" IsOptional="true"
                                   Validator="ValidateHeight" Placeholder="168" MaxLength="3" />
                        <TextField Label="@AppText.Player.WeightLabel" @bind-Value="mWeightText" IsOptional="true"
                                   Validator="ValidateWeight" Placeholder="58" MaxLength="3" />
                    </div>

                    <SelectField TValue="string" Label="@AppText.Player.FieldFoot" @bind-Value="mFoot" IsOptional="true"
                                 Options="@FootOptions" Placeholder="@AppText.Player.FootSelectPlaceholder" />

                    <TextField Label="@AppText.Player.SchoolLabel" @bind-Value="mSchool" IsOptional="true"
                               Placeholder="@AppText.Player.SchoolPlaceholder" MaxLength="100"
                               Helper="@AppText.Player.SchoolHelper" />

                    <TextField Label="@AppText.Player.SlugLabel" @bind-Value="mSlug" Validator="ValidateSlug"
                               Placeholder="gangmin" MaxLength="30"
                               Helper="@SlugHelper" />

                    @* 강점 태그 — 폼 안에서 편집, 저장은 아래 저장 버튼(공개 스위치는 공개 범위 설정 절에 별도) *@
                    <StrengthTagInput @bind-Value="mTags" Position="@Profile?.Position" Presets="@mPresets" />
                </div>

                <div class="@Css.MatchForm.Footer">
                    <button type="button" class="@Css.MatchForm.CancelButton" @onclick="CancelAsync">@AppText.Player.Cancel</button>
                    <SubmitButton Label="@AppText.Player.Save" BusyLabel="@AppText.Player.SavingBusy" IsBusy="@mSaving" OnClick="SubmitAsync"
                                  Class="@Css.MatchForm.SubmitWidth" />
                </div>
            </CascadingValue>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>편집 대상 자녀 — 보호자가 자녀를 여러 명 관리할 수 있다.</summary>
    [Parameter]
    public Guid? PlayerId { get; set; }

    /// <summary>현재 프로필 — 열 때 초기값을 채운다.</summary>
    [Parameter]
    public PlayerProfileDto? Profile { get; set; }

    /// <summary>현재 강점 태그 — 열 때 로컬 복사본을 만든다(취소 시 원복).</summary>
    [Parameter]
    public List<string> CurrentTags { get; set; } = new();

    /// <summary>저장 성공 후 상위(페이지)가 프로필을 다시 읽는다.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    private static readonly List<SelectOption<string>> FootOptions = new()
    {
        new SelectOption<string>("Left", AppText.Player.FootLeft),
        new SelectOption<string>("Right", AppText.Player.FootRight),
        new SelectOption<string>("Both", AppText.Player.FootBoth),
    };

    // 소문자 영숫자, 하이픈 허용(양끝·연속 하이픈 금지) — 서버 규칙과 같다.
    private static readonly Regex SlugRegex = new(@"^[a-z0-9]+(-[a-z0-9]+)*$", RegexOptions.Compiled);

    // 예약어 — 서버(SoccerPlayerProfileInfoUpdateCommand)와 같은 목록.
    private static readonly HashSet<string> Reserved = new(StringComparer.OrdinalIgnoreCase)
    {
        "me", "api", "admin", "new", "edit", "player", "team", "teams",
        "settings", "dashboard", "card", "login", "records", "claim"
    };

    private readonly FormFieldContext mForm = new();

    private string? mHeightText;
    private string? mWeightText;
    private string? mFoot;
    private string? mSchool;
    private string? mSlug;
    private string? mTakenSlug; // 서버가 "이미 사용 중"이라고 돌려준 값 — 인라인 오류 표시용
    private bool mSaving;
    private bool mLoaded;

    // 강점 태그 — 로컬 편집본과 원본(변경 여부 판정용), 포지션별 프리셋
    private List<string> mTags = new();
    private List<string> mInitialTags = new();
    private List<StrengthTagPresetDto> mPresets = new();

    private string SlugHelper => AppText.Player.SlugHelper(string.IsNullOrWhiteSpace(mSlug) ? "…" : mSlug.Trim().ToLowerInvariant());

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen)
        {
            mLoaded = false;
            return;
        }

        if (mLoaded)
        {
            return;
        }

        mLoaded = true;
        mHeightText = Profile?.HeightCm?.ToString();
        mWeightText = Profile?.WeightKg?.ToString();
        mFoot = Profile?.PreferredFoot;
        mSchool = Profile?.SchoolName;
        mSlug = Profile?.Slug;
        mTakenSlug = null;

        // 강점 태그 — 열 때 현재값을 복사(취소 시 원복). 프리셋은 열 때 1회 로드.
        mTags = CurrentTags is null ? new List<string>() : new List<string>(CurrentTags);
        mInitialTags = new List<string>(mTags);
        mPresets = await Players.GetStrengthTagPresetsAsync();
    }

    private string? ValidateSlug(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return AppText.Player.ErrorSlugEmpty;
        }

        string v = value.Trim().ToLowerInvariant();
        if (v.Length < 3 || v.Length > 30)
        {
            return AppText.Player.ErrorSlugLength;
        }

        if (!SlugRegex.IsMatch(v))
        {
            return AppText.Player.ErrorSlugCharset;
        }

        if (Reserved.Contains(v))
        {
            return AppText.Player.ErrorSlugReserved;
        }

        if (mTakenSlug is not null && string.Equals(v, mTakenSlug, StringComparison.Ordinal))
        {
            return AppText.Player.ErrorSlugTaken;
        }

        return null;
    }

    private static string? ValidateHeight(string? value) => ValidateRange(value, 100, 230, AppText.Player.FieldHeight);

    private static string? ValidateWeight(string? value) => ValidateRange(value, 20, 150, AppText.Player.FieldWeight);

    private static string? ValidateRange(string? value, int min, int max, string label)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null; // 선택 항목 — 비워두면 지운다
        }

        if (!int.TryParse(value.Trim(), out int n))
        {
            return $"{label}는 숫자로 입력해 주세요.";
        }

        if (n < min || n > max)
        {
            return $"{label}는 {min}~{max} 사이로 입력해 주세요.";
        }

        return null;
    }

    private async Task SubmitAsync()
    {
        if (!await mForm.ValidateAllAsync())
        {
            return;
        }

        var request = new UpdatePlayerProfileInfoRequest
        {
            HeightCm = ParseIntOrNull(mHeightText),
            WeightKg = ParseIntOrNull(mWeightText),
            PreferredFoot = string.IsNullOrWhiteSpace(mFoot) ? null : mFoot,
            SchoolName = string.IsNullOrWhiteSpace(mSchool) ? null : mSchool.Trim(),
            Slug = string.IsNullOrWhiteSpace(mSlug) ? null : mSlug.Trim().ToLowerInvariant(),
        };

        mSaving = true;
        ProfileInfoSaveOutcome outcome = await Players.UpdateProfileInfoAsync(request, PlayerId);
        mSaving = false;

        // 주소만 중복 — 수치는 저장됐다. 다이얼로그를 닫지 않고 주소 필드에 인라인 오류를 띄운다.
        if (outcome == ProfileInfoSaveOutcome.SlugTaken)
        {
            mTakenSlug = request.Slug;
            await mForm.ValidateAllAsync();
            return;
        }

        if (outcome == ProfileInfoSaveOutcome.Failed)
        {
            Toasts.ShowError("저장하지 못했어요. 잠시 후 다시 시도해 주세요.", "재시도", SubmitAsync);
            return;
        }

        // 프로필 정보 저장 성공 후 — 강점 태그가 바뀌었을 때만 별도 저장(관리 주체 계정, 순서 보존).
        // 실패하면 수치는 저장됐으니 닫지 않고 인라인 없이 토스트로 재시도를 유도(원본 유지 → 재제출 시 재시도).
        if (!mTags.SequenceEqual(mInitialTags))
        {
            if (!await Players.SaveStrengthTagsAsync(mTags, PlayerId))
            {
                Toasts.ShowError("강점 태그를 저장하지 못했어요. 잠시 후 다시 시도해 주세요.", "재시도", SubmitAsync);
                return;
            }
        }

        Toasts.ShowSuccess("프로필을 수정했어요.");
        await CloseAsync();
        await OnSaved.InvokeAsync();
    }

    private static int? ParseIntOrNull(string? text) =>
        int.TryParse(text?.Trim(), out int n) ? n : null;

    private Task CancelAsync() => CloseAsync();

    private async Task CloseAsync()
    {
        mLoaded = false;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}

@* 내 자녀 — 이니셜 아바타 + Claim 뱃지 + 시즌 3스탯 + 액션 (Design.DashboardHub §내 자녀).
   Claimed = 연결됨 + 스탯 + [선수 대시보드] + [공개 프로필] / Pending = 승인 대기 + 스탯 "–" + 대기 안내 + [요청 상태 보기]. *@
@using PlayGround.Contracts.Team
@using PlayGround.Client.Styles

<article class="@Css.Hub.ChildCard">
    <div class="flex items-center gap-3">
        <Avatar Name="@Child.Name" Size="44" />
        <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
                <h3 class="@Css.Hub.ChildName">@Child.Name</h3>
                @* 허브 카피는 한글 — 팀 대시보드의 ClaimBadge는 영문 표기(SPEC.TEAMDASHBOARD)라 쓰지 않는다 *@
                @if (IsPending)
                {
                    <StatusBadge Tone="StatusBadge.BadgeTone.Pending">@AppText.Hub.PendingApproval</StatusBadge>
                }
                else
                {
                    <StatusBadge Tone="StatusBadge.BadgeTone.Positive">@AppText.Hub.Linked</StatusBadge>
                }
            </div>
            @if (Meta is not null)
            {
                <p class="@Css.Hub.ChildMeta">@Meta</p>
            }
        </div>
    </div>

    <div class="@Css.Hub.StatGrid">
        <div class="@Css.Hub.StatCell"><span class="@Css.Hub.StatValue">@StatOf(Child.Appearances)</span><span class="@Css.Hub.StatKey">@AppText.Hub.StatAppearances</span></div>
        <div class="@Css.Hub.StatCell"><span class="@Css.Hub.StatValue">@StatOf(Child.Goals)</span><span class="@Css.Hub.StatKey">@AppText.Hub.StatGoals</span></div>
        <div class="@Css.Hub.StatCell"><span class="@Css.Hub.StatValue">@StatOf(Child.Assists)</span><span class="@Css.Hub.StatKey">@AppText.Hub.StatAssists</span></div>
    </div>

    @if (IsPending)
    {
        <p class="@Css.Hub.ChildMeta">@PendingNote</p>
        <div class="flex gap-2">
            <a href="@Routes.Claim" class="@Css.Hub.ChildPrimary">@AppText.Hub.ViewRequestStatus</a>
        </div>
    }
    else
    {
        @* 기록 수정 신청 요약(접수 건이 있을 때만) — 전체 목록은 선수 대시보드 시즌 통계에 있다 *@
        @if (Child.CorrectionPendingCount > 0)
        {
            <a href="@CorrectionHref" class="@Css.Hub.CorrectionNotice">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none"><path d="M12 9v4M12 17h.01"></path><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
                <span>@AppText.Hub.CorrectionInProgress(Child.CorrectionPendingCount)</span>
                <span class="ml-auto">@AppText.Hub.ViewMore</span>
            </a>
        }

        @* 지원 현황 요약(진행 중 지원이 있을 때만) — 전체 현황은 선수 대시보드 "내 지원 현황"에 있다 *@
        @if (Child.ApplicationPendingCount > 0)
        {
            <a href="@ApplicationHref" class="@(Child.ApplicationActionNeeded ? Css.Hub.ApplicationActionNotice : Css.Hub.ApplicationInfoNotice)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M9 13h6M9 17h4"></path></svg>
                @if (Child.ApplicationActionNeeded)
                {
                    <span>@AppText.Hub.ApplicationNeedsCheck(Child.ApplicationPendingCount)</span>
                }
                else
                {
                    <span>@AppText.Hub.ApplicationInProgress(Child.ApplicationPendingCount)</span>
                }
                <span class="ml-auto">@AppText.Hub.ViewMore</span>
            </a>
        }
        @* 팀 소식 안읽음 요약(안읽은 글이 있을 때만) — 전체 목록은 팀 소식 화면(Design.TeamBoard) *@
        @if (Child.TeamNewsUnreadCount > 0)
        {
            <a href="@TeamNewsHref" class="@Css.Hub.ApplicationInfoNotice">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none"><path d="M20 15a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2z"></path></svg>
                <span>@AppText.Hub.TeamNewsUnread(Child.TeamNewsUnreadCount)</span>
                <span class="ml-auto">@AppText.Hub.ViewMore</span>
            </a>
        }
        <div class="flex gap-2">
            <a href="@ChildDashboardHref" class="@Css.Hub.ChildPrimary">@AppText.Hub.PlayerDashboard</a>
            @if (!string.IsNullOrEmpty(Child.Slug))
            {
                <a href="@Routes.PlayerPublicProfile(Child.Slug)" target="_blank" rel="noopener" class="@Css.Hub.ChildSecondary">@AppText.Hub.PublicProfile</a>
            }
        </div>
    }
</article>

@code {
    [Parameter]
    public HubChildDto Child { get; set; } = new();

    private bool IsPending => Child.ClaimStatus == "Pending";

    private string ChildDashboardHref => $"{Routes.PlayerDashboard}?playerId={Child.PlayerId}";

    // 기록 수정 신청 전체 목록이 있는 자리 = 선수 대시보드 시즌 통계(현재 자녀 유지)
    private string CorrectionHref =>
        Routes.PlayerDashboardSection(SoccerPlayerDashboardSection.Stats, Child.PlayerId);

    // 지원 현황 전체가 있는 자리 = 선수 대시보드 기본(프로필) 섹션 상단 "내 지원 현황"(현재 자녀 유지)
    private string ApplicationHref => $"{Routes.PlayerDashboard}?playerId={Child.PlayerId}";

    private string TeamNewsHref => Routes.TeamNews(Child.PlayerId);

    // Pending은 아직 기록이 없다 — 스탯은 "–"
    private string StatOf(int value) => IsPending ? AppText.Hub.StatPlaceholder : value.ToString();

    private string PendingNote
    {
        get
        {
            string team = string.IsNullOrWhiteSpace(Child.TeamName) ? AppText.Hub.TeamFallback : Child.TeamName;
            string when = Child.RequestedAt is SystemTime d
                ? AppText.Hub.RequestedAt(d.ToWallClock().ToString("M/d"))
                : string.Empty;
            return AppText.Hub.PendingWaiting(team, when);
        }
    }

    private string? Meta
    {
        get
        {
            var parts = new List<string>();
            if (Child.AgeGroup is not null) { parts.Add(Child.AgeGroup.ToString()!); }
            if (Child.Position is not null) { parts.Add(Child.Position.ToString()!); }
            if (!string.IsNullOrWhiteSpace(Child.JerseyNumber)) { parts.Add($"#{Child.JerseyNumber}"); }
            // Pending은 메타에 팀명을 넣지 않는다 — 대기 안내 문구에서 팀을 말한다(중복 방지)
            if (!IsPending && !string.IsNullOrWhiteSpace(Child.TeamName)) { parts.Add(Child.TeamName); }

            return parts.Count == 0 ? null : string.Join(" · ", parts);
        }
    }
}

@* 내 팀 — 네이비 그라디언트 카드. "팀 대시보드"가 허브의 유일한 오렌지 버튼이다. *@
@using System.Globalization
@using PlayGround.Contracts.Team
@using PlayGround.Client.Styles

<article class="@Css.Hub.TeamCard">
    <span class="@Css.Hub.TeamDecor"></span>

    <div class="relative flex items-center gap-3.5">
        <span class="@Css.Hub.TeamIconBox">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" class="text-white/80"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </span>

        <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
                <h3 class="@Css.Hub.TeamName">@Team.TeamName</h3>
                @if (Team.IsVerified)
                {
                    <span class="@Css.Hub.TeamVerified">@AppText.Hub.TeamVerified</span>
                }
            </div>
            @* 요약은 값이 있는 조각만 잇는다 — "미처리 연결 요청 0건"을 쓰지 않는다 *@
            <p class="@Css.Hub.TeamSummary">@Summary</p>
        </div>
    </div>

    @* 다음 경기 — 경기·대회 중 가장 가까운 미래 1건(훈련 제외). 없으면 줄 생략(Design.Schedule) *@
    @if (Team.NextMatchStartsAt is DateTime next)
    {
        <p class="relative mt-3 m-0 text-[13px] font-bold text-teal">@AppText.Hub.NextMatch(NextMatchLabel(next))</p>
    }

    <div class="relative mt-4 flex gap-2">
        <a href="@Routes.TeamDashboard" class="@($"{Css.Hub.TeamPrimary} flex-1 md:flex-none")">@AppText.Hub.TeamDashboard</a>
        @if (!string.IsNullOrWhiteSpace(Team.Slug))
        {
            <a href="@Routes.TeamPublicHome(Team.Slug)" class="@($"{Css.Hub.TeamGhost} flex-1 md:flex-none")">@AppText.Hub.TeamPublicHome</a>
        }
    </div>
</article>

@code {
    [Parameter]
    public HubTeamDto Team { get; set; } = new();

    private string Summary
    {
        get
        {
            var parts = new List<string> { AppText.Hub.PlayerCount(Team.PlayerCount) };
            if (Team.PendingInviteCount > 0)
            {
                parts.Add(AppText.Hub.PendingInvites(Team.PendingInviteCount));
            }

            return string.Join(" · ", parts);
        }
    }

    // "다음 경기 — {M/D}({요일}) {HH:mm} vs {상대}" — 상대 없으면(대회) vs 부분 생략. 포맷은 Invariant.
    private string NextMatchLabel(DateTime dt)
    {
        string weekday = new[] { AppText.Hub.DowSun, AppText.Hub.DowMon, AppText.Hub.DowTue, AppText.Hub.DowWed, AppText.Hub.DowThu, AppText.Hub.DowFri, AppText.Hub.DowSat }[(int)dt.DayOfWeek];
        string datePart = $"{dt.ToString("M/d", CultureInfo.InvariantCulture)}({weekday}) {dt.ToString("HH:mm", CultureInfo.InvariantCulture)}";

        return string.IsNullOrWhiteSpace(Team.NextMatchOpponent)
            ? datePart
            : $"{datePart} vs {Team.NextMatchOpponent}";
    }
}

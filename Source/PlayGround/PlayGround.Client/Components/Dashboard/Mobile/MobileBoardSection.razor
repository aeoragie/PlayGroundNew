@* 팀 게시판 섹션(모바일): 세그먼트 풀폭 + 행(유형·눈 아이콘을 제목 위 줄) + ⋯ 바텀시트.
   작성 버튼은 목록 하단 풀폭(대시보드 주 액션 오렌지 1개 규칙 내). 행 높이 56px+. *@
@using PlayGround.Client.Styles
@using PlayGround.Client.Services.Feedback
@using PlayGround.Contracts.Team
@inject TeamClient Teams
@inject ToastService Toasts
@inject ConfirmService Confirm

<div class="flex flex-col gap-3">
    <h1 class="@Css.Dashboard.SectionTitle">@AppText.Dashboard.BoardTitle</h1>

    @if (Data.Posts.Count == 0)
    {
        <EmptyState Kind="EmptyState.Art.Record" Title="@AppText.Dashboard.BoardEmptyTitle">
            <Description>@AppText.Dashboard.BoardEmptyBodyMobile</Description>
        </EmptyState>
        <button type="button" class="@Css.Dashboard.MobilePrimaryButton" @onclick="OpenCreate">@AppText.Dashboard.WritePost</button>
    }
    else
    {
        <div class="@Css.Segment.Track">
            <button type="button" class="@Css.Segment.Item(mFilter is null)" @onclick="() => mFilter = null">@AppText.Dashboard.SegAll @Data.Posts.Count</button>
            <button type="button" class="@Css.Segment.Item(mFilter == "Notice")" @onclick="@(() => mFilter = "Notice")">@AppText.Dashboard.SegNotice @CountOf("Notice")</button>
            <button type="button" class="@Css.Segment.Item(mFilter == "Material")" @onclick="@(() => mFilter = "Material")">@AppText.Dashboard.SegMaterial @CountOf("Material")</button>
        </div>

        @foreach (TeamPostDto post in Filtered)
        {
            <div class="@($"{RowClass(post)} min-h-[56px]")">
                <span class="flex flex-col gap-[3px] flex-1 min-w-0">
                    <span class="flex items-center gap-1.5">
                        @if (post.IsPinned)
                        {
                            <span class="text-[9.5px] font-extrabold text-white bg-navy rounded-[99px] px-2 py-[2px] whitespace-nowrap">@AppText.Dashboard.Pinned</span>
                        }
                        <span class="@TypeBadgeClass(post)">@TypeLabel(post)</span>
                        @if (post.IsPublic)
                        {
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#2EC4B6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><title>@AppText.Dashboard.PublicOnHome</title><path d="M12 4.5c-3.6 0-6.8 2.2-9 7.5 2.2 5.3 5.4 7.5 9 7.5s6.8-2.2 9-7.5c-2.2-5.3-5.4-7.5-9-7.5z"></path><circle cx="12" cy="12" r="2.8"></circle></svg>
                        }
                    </span>
                    <span class="text-[13px] font-extrabold text-navy-deep truncate">@post.Title</span>
                    <span class="text-[11px] text-text-muted whitespace-nowrap truncate">@MetaOf(post)</span>
                </span>
                <OverflowMenu Target="@post.Title" Items="@MenuItemsOf(post)" DestructiveItems="@DestructiveItemsOf(post)" />
            </div>
        }

        <button type="button" class="@Css.Dashboard.MobilePrimaryButton" @onclick="OpenCreate">@AppText.Dashboard.WritePost</button>
    }

    <BoardFormDialog @bind-IsOpen="mFormOpen" Editing="@mEditing" OnSaved="OnChangedAsync" />
</div>

@code {
    [Parameter, EditorRequired]
    public TeamPostsResponse Data { get; set; } = new();

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private string? mFilter;
    private bool mFormOpen;
    private TeamPostDto? mEditing;

    private List<TeamPostDto> Filtered =>
        (mFilter is null ? Data.Posts : Data.Posts.Where(p => p.Type == mFilter)).ToList();

    private int CountOf(string type) => Data.Posts.Count(p => p.Type == type);

    private string RowClass(TeamPostDto post) =>
        "flex items-center gap-3 rounded-[12px] px-[13px] py-3 " + (post.IsPinned
            ? "border-[1.5px] border-navy/20 bg-navy/[.03]"
            : "border border-border");

    private static string TypeLabel(TeamPostDto post) => post.Type == "Notice" ? AppText.Dashboard.SegNotice : AppText.Dashboard.SegMaterial;

    private static string TypeBadgeClass(TeamPostDto post) =>
        post.Type == "Notice"
            ? "text-[9.5px] font-extrabold text-white bg-navy rounded-[99px] px-2 py-[2px] whitespace-nowrap"
            : Css.Badge.Neutral;

    private static string MetaOf(TeamPostDto post)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(post.AuthorName))
        {
            parts.Add(post.AuthorName!);
        }

        parts.Add(post.CreatedAt.ToLocalTime().ToString("M/d", System.Globalization.CultureInfo.InvariantCulture));
        if (post.Files.Count > 0)
        {
            parts.Add(AppText.Dashboard.AttachmentCount(post.Files.Count));
        }

        parts.Add(AppText.Dashboard.ViewCount(post.ViewCount));
        return string.Join(" · ", parts);
    }

    private List<OverflowMenu.MenuItem> MenuItemsOf(TeamPostDto post) => new()
    {
        new(AppText.Dashboard.Edit, () => { OpenEdit(post); return Task.CompletedTask; }),
        new(post.IsPinned ? AppText.Dashboard.Unpin : AppText.Dashboard.Pin, () => TogglePinAsync(post)),
        new(post.IsPublic ? AppText.Dashboard.Unpublish : AppText.Dashboard.Publish, () => TogglePublicAsync(post)),
    };

    private List<OverflowMenu.MenuItem> DestructiveItemsOf(TeamPostDto post) =>
        new() { new(AppText.Dashboard.Delete, () => DeleteAsync(post)) };

    private void OpenCreate()
    {
        mEditing = null;
        mFormOpen = true;
    }

    private void OpenEdit(TeamPostDto post)
    {
        mEditing = post;
        mFormOpen = true;
    }

    private async Task TogglePinAsync(TeamPostDto post)
    {
        if (await Teams.SetPostPinnedAsync(post.PostId, !post.IsPinned))
        {
            await OnChangedAsync();
            return;
        }

        Toasts.ShowError(post.IsPinned ? AppText.Dashboard.UnpinFailedToast : AppText.Dashboard.PinLimitToast);
    }

    private async Task TogglePublicAsync(TeamPostDto post)
    {
        if (await Teams.SetPostPublicAsync(post.PostId, !post.IsPublic))
        {
            Toasts.ShowSuccess(post.IsPublic ? AppText.Dashboard.UnpublishedToast : AppText.Dashboard.PublishedToast);
            await OnChangedAsync();
            return;
        }

        Toasts.ShowError(AppText.Dashboard.PublicToggleFailedToast);
    }

    private async Task DeleteAsync(TeamPostDto post)
    {
        bool confirmed = await Confirm.ShowAsync(new ConfirmRequest
        {
            Kind = ConfirmKind.Destructive,
            Title = AppText.Dashboard.DeletePostTitle(post.Title),
            Description = post.Files.Count > 0
                ? AppText.Dashboard.DeletePostWithFiles
                : AppText.Dashboard.DeletePostPublicNote,
            ConfirmLabel = AppText.Dashboard.Delete,
        });

        if (!confirmed)
        {
            return;
        }

        if (await Teams.DeletePostAsync(post.PostId))
        {
            Toasts.ShowSuccess(AppText.Dashboard.PostDeletedToast, AppText.Dashboard.Undo, () => RestoreAsync(post));
            await OnChangedAsync();
            return;
        }

        Toasts.ShowError(AppText.Dashboard.DeleteFailedToast);
    }

    private async Task RestoreAsync(TeamPostDto post)
    {
        if (await Teams.DeletePostAsync(post.PostId, restore: true))
        {
            await OnChangedAsync();
            return;
        }

        Toasts.ShowError(AppText.Dashboard.RestoreFailedToast);
    }

    private async Task OnChangedAsync()
    {
        await OnChanged.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }
}

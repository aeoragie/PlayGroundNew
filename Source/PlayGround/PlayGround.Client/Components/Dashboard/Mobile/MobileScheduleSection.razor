@* 일정(모바일): 날짜 컬럼 38px, 유형 pill+시간을 제목 위 한 줄로 · ⋯ = 바텀시트(OverflowMenu 자동).
   상태·정렬·비공개 규칙은 PC와 동일(SPEC.SCHEDULE) — 종료 행은 55% 투명 + 읽기 전용(⋯ 없음). *@
@using PlayGround.Client.Models
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Team
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject ToastService Toasts

<div class="flex flex-col gap-3">
    <div class="flex justify-between items-center">
        <h1 class="m-0 text-[19px] font-extrabold text-navy-deep">@AppText.Dashboard.ScheduleTitle <span class="text-[13px] font-bold text-text-muted">@MonthLabel</span></h1>
        <button type="button" class="@Css.Dashboard.MobilePrimaryButton" @onclick="OnAdd">@AppText.Dashboard.AddSchedule</button>
    </div>

    @if (Schedules.Count == 0)
    {
        <EmptyState Kind="EmptyState.Art.Record" Title="@AppText.Dashboard.ScheduleEmptyTitle">
            <Description>@AppText.Dashboard.ScheduleEmptyBody</Description>
        </EmptyState>
    }
    else
    {
        @foreach (ScheduleDto schedule in Sorted)
        {
            ScheduleDto item = schedule;
            bool ended = IsEnded(item);
            <div class="@($"{Css.Dashboard.Card} rounded-[13px] px-[15px] py-[13px] flex items-center gap-[13px] {(ended ? "opacity-[.55]" : "")}")">
                <span class="flex flex-col items-center w-[38px] shrink-0">
                    <span class="text-[10.5px] font-bold @WeekdayClass(item.StartsAt)">@WeekdayLabel(item.StartsAt)</span>
                    <span class="text-lg font-extrabold text-navy-deep tabular-nums">@item.StartsAt.Day</span>
                </span>
                <span class="flex flex-col gap-[3px] flex-1 min-w-0">
                    <span class="flex items-center gap-[7px]">
                        <span class="@TypeClass(TypeOf(item))">@TypeOf(item).ToLabel()</span>
                        <span class="text-[11.5px] font-bold text-text-strong whitespace-nowrap">@TimeOf(item)</span>
                    </span>
                    <span class="text-[13.5px] font-bold text-navy-deep break-keep flex items-center gap-1.5">
                        @TitleOf(item)
                        @if (!item.IsPublic)
                        {
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="text-text-muted shrink-0"><rect x="5" y="10" width="14" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 018 0v3"></path></svg>
                        }
                    </span>
                    <span class="text-[11.5px] text-text-body break-keep">@MetaOf(item, ended)</span>
                </span>
                @if (!ended)
                {
                    <OverflowMenu Target="@TitleOf(item)"
                                  Items="@MenuItemsOf(item)"
                                  DestructiveItems="@DestructiveItemsOf(item)" />
                }
            </div>
        }
    }

    <div class="flex items-center gap-2.5 flex-wrap pt-0.5">
        <div class="text-[11.5px] text-text-muted break-keep flex-1 min-w-0">@AppText.Dashboard.ScheduleFootNote</div>
        @if (!string.IsNullOrWhiteSpace(TeamSlug))
        {
            <button type="button" @onclick="CopyFeedAsync"
                    class="text-[12px] font-bold text-navy hover:text-orange bg-transparent border-0 cursor-pointer p-0 whitespace-nowrap transition-colors">@AppText.Dashboard.CopySubscribeLink</button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public List<ScheduleDto> Schedules { get; set; } = new();

    /// <summary>구독 링크 복사용 팀 슬러그 — 없으면 버튼 미노출.</summary>
    [Parameter]
    public string? TeamSlug { get; set; }

    [Parameter]
    public EventCallback OnAdd { get; set; }

    [Parameter]
    public EventCallback<ScheduleDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<ScheduleDto> OnDelete { get; set; }

    private static string MonthLabel => AppText.Dashboard.MonthLabelShort(DateTime.Now.Month);

    // 공개 iCal 피드 절대 URL 복사(토큰 없는 공개 URL)
    private async Task CopyFeedAsync()
    {
        string url = Nav.ToAbsoluteUri($"api/soccer/team/{Uri.EscapeDataString(TeamSlug!)}/schedule.ics").ToString();
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", url);
        Toasts.ShowSuccess(AppText.Dashboard.CopiedToast);
    }

    private static bool IsEnded(ScheduleDto s) => s.StartsAt < DateTime.Now;

    private IEnumerable<ScheduleDto> Sorted =>
        Schedules
            .Where(s => !IsEnded(s))
            .OrderBy(s => s.StartsAt)
            .Concat(Schedules
                .Where(IsEnded)
                .OrderByDescending(s => s.StartsAt));

    private static SoccerScheduleEventType TypeOf(ScheduleDto s) =>
        Enum.TryParse(s.Type, out SoccerScheduleEventType type) ? type : SoccerScheduleEventType.Match;

    private static string TitleOf(ScheduleDto s) =>
        TypeOf(s) == SoccerScheduleEventType.Match
            ? $"vs {s.OpponentName}"
            : (s.Title ?? string.Empty);

    private static string TimeOf(ScheduleDto s) => s.StartsAt.ToString("HH:mm");

    private static string WeekdayLabel(DateTime dt) =>
        new[] { AppText.Dashboard.DowSun, AppText.Dashboard.DowMon, AppText.Dashboard.DowTue, AppText.Dashboard.DowWed, AppText.Dashboard.DowThu, AppText.Dashboard.DowFri, AppText.Dashboard.DowSat }[(int)dt.DayOfWeek];

    private static string WeekdayClass(DateTime dt) =>
        dt.DayOfWeek == DayOfWeek.Sunday ? "text-weekend-sun" : "text-text-muted";

    private static string MetaOf(ScheduleDto s, bool ended)
    {
        var parts = new List<string> { s.Venue };
        if (ended)
        {
            bool resultLinked = s.HasResult && TypeOf(s) is SoccerScheduleEventType.Match or SoccerScheduleEventType.Tournament;
            parts.Add(resultLinked ? AppText.Dashboard.FinishedWithResult : AppText.Dashboard.Finished);
        }

        if (!s.IsPublic)
        {
            parts.Add(AppText.Dashboard.Private);
        }

        return string.Join(" · ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));
    }

    private List<OverflowMenu.MenuItem> MenuItemsOf(ScheduleDto item) =>
        new() { new(AppText.Dashboard.Edit, () => OnEdit.InvokeAsync(item)) };

    private List<OverflowMenu.MenuItem> DestructiveItemsOf(ScheduleDto item) =>
        new() { new(AppText.Dashboard.Delete, () => OnDelete.InvokeAsync(item)) };

    private static string TypeClass(SoccerScheduleEventType type) =>
        "text-[10.5px] font-bold rounded-full px-[9px] py-0.5 whitespace-nowrap shrink-0 " + type switch
        {
            SoccerScheduleEventType.Match => "text-white bg-navy",
            SoccerScheduleEventType.Tournament => "text-orange-ink bg-surface-orange-badge",
            _ => "text-teal-ink bg-teal/[.12]",
        };
}

@* 게시판 글 작성·수정 — PC 중앙 모달 / 모바일 전체 시트 (Css.MatchForm 골격 재사용).
   유형 2종(공지/자료) · 제목 2~60 · 내용 2000자 카운터 · 첨부 최대 3(pdf·이미지·hwp, 10MB) ·
   공개 스위치 기본 끔(실수 공개 방지). 신규 공지면 저장 시 서버가 보호자 알림을 발송한다.
   저장 성공 = 토스트(A2), 검증 오류·첨부 오류 = 인라인(폼 오류에 토스트 금지). *@
@using Microsoft.AspNetCore.Components.Forms
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Common
@using PlayGround.Contracts.Team
@using PlayGround.Domain.Soccer
@inject TeamClient Teams
@inject ToastService Toasts

@if (IsOpen)
{
    <div class="@Css.MatchForm.Overlay">
        <div class="fixed inset-0" @onclick="CancelAsync"></div>

        <div class="@Css.MatchForm.Card">
            <span class="@Css.MatchForm.GrabBar"></span>

            <div class="@Css.MatchForm.Header">
                <span class="flex flex-col gap-1 min-w-0">
                    <h2 class="@Css.MatchForm.Title">@(IsEdit ? "글 수정" : "글 작성")</h2>
                    <span class="@Css.MatchForm.Subtitle">공지는 발행 시 소속 보호자에게 알림이 가요. 공개로 켜면 소개 탭 "팀 소식"에 보여요.</span>
                </span>
                <button type="button" aria-label="닫기" class="@Css.MatchForm.CloseButton" @onclick="CancelAsync">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>

            <CascadingValue Value="@mForm" IsFixed="true">
                <div class="@Css.MatchForm.Body">
                    <RadioCards TValue="SoccerTeamPostType" Label="유형" Value="mType"
                                ValueChanged="OnTypeChanged" Options="@TypeOptions" />

                    <TextField Label="제목" @bind-Value="mTitle" Placeholder="8월 훈련 일정 변경 안내"
                               Validator="ValidateTitle" MaxLength="60" />

                    <TextField Label="내용" @bind-Value="mBody" Multiline="true" Rows="5"
                               Placeholder="보호자에게 알릴 내용을 적어 주세요." Validator="ValidateBody" MaxLength="2000" />

                    @* 첨부 — pdf·이미지·hwp, 10MB, 최대 3개 *@
                    <div class="flex flex-col gap-2">
                        <label class="@Css.Form.Label">첨부<span class="@Css.Form.OptionalMark"> (선택 · 최대 3개)</span></label>

                        @if (mFiles.Count > 0)
                        {
                            <div class="flex flex-col gap-1.5">
                                @foreach (TeamPostFileInput f in mFiles)
                                {
                                    <div class="flex items-center gap-2.5 border border-border rounded-[10px] px-3 py-2.5 bg-surface-soft">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8a93a6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M14.5 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V7.5z"></path><path d="M14 3v5h5"></path></svg>
                                        <span class="flex-1 min-w-0 text-[13px] font-semibold text-navy-deep truncate">@f.Name</span>
                                        <span class="text-[11px] text-text-muted whitespace-nowrap shrink-0">@SizeText(f.SizeBytes)</span>
                                        <button type="button" aria-label="첨부 삭제" class="shrink-0 text-text-muted hover:text-danger bg-transparent border-0 cursor-pointer p-0"
                                                @onclick="() => RemoveFile(f)">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        @if (mFiles.Count < MaxFiles)
                        {
                            <div class="relative">
                                <button type="button" class="w-full h-11 border border-dashed border-navy-muted rounded-[10px] bg-surface-soft text-[13px] font-bold text-navy flex items-center justify-center gap-2 whitespace-nowrap">
                                    @if (mUploading)
                                    {
                                        <span>올리는 중…</span>
                                    }
                                    else
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V5M8 8.5L12 4.5l4 4M5 19h14"></path></svg>
                                        <span>파일 첨부 (최대 @(MaxFiles)개)</span>
                                    }
                                </button>
                                <InputFile OnChange="OnFilesPickedAsync" multiple
                                           accept=".pdf,.hwp,.hwpx,.jpg,.jpeg,.png,.webp"
                                           class="absolute inset-0 opacity-0 cursor-pointer" disabled="@mUploading" />
                            </div>
                            <span class="text-[11px] text-text-muted whitespace-nowrap">pdf·이미지·hwp · 10MB · 최대 @(MaxFiles)개</span>
                        }

                        @if (mAttachError is not null)
                        {
                            <span class="@Css.Form.ErrorMessage">@mAttachError</span>
                        }
                    </div>

                    @* 공개 스위치 — 폼 상태만 바꾼다(즉시 저장 아님). 기본 끔 *@
                    <Switch Label="공개 홈페이지에도 노출"
                            Description="켜면 소개 탭 '팀 소식'에 보여요 · 끄면 소속 보호자만"
                            Value="mIsPublic" ValueChanged="(v) => mIsPublic = v" />
                </div>

                <div class="@Css.MatchForm.Footer">
                    <button type="button" class="@Css.MatchForm.CancelButton" @onclick="CancelAsync">취소</button>
                    <SubmitButton Label="@(IsEdit ? "저장" : "올리기")" BusyLabel="저장 중…" IsBusy="@mSaving"
                                  OnClick="SubmitAsync" Class="@Css.MatchForm.SubmitWidth" />
                </div>
            </CascadingValue>
        </div>
    </div>
}

@code {
    private const int MaxFiles = 3;
    private const long MaxBytes = 10 * 1024 * 1024;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>수정 대상 — null이면 신규 작성.</summary>
    [Parameter]
    public TeamPostDto? Editing { get; set; }

    /// <summary>저장 성공 후 — 부모가 목록을 다시 불러온다.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    private readonly FormFieldContext mForm = new();

    private SoccerTeamPostType mType = SoccerTeamPostType.Notice;
    private string mTitle = string.Empty;
    private string mBody = string.Empty;
    private List<TeamPostFileInput> mFiles = new();
    private bool mIsPublic;
    private bool mUploading;
    private string? mAttachError;
    private bool mSaving;
    private Guid mLoadedFor;
    private bool mLoaded;

    private bool IsEdit => Editing is not null;

    private static readonly List<SelectOption<SoccerTeamPostType>> TypeOptions = new()
    {
        new SelectOption<SoccerTeamPostType>(SoccerTeamPostType.Notice, "공지"),
        new SelectOption<SoccerTeamPostType>(SoccerTeamPostType.Material, "자료"),
    };

    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            mLoaded = false;
            mLoadedFor = Guid.Empty;
            return;
        }

        Guid target = Editing?.PostId ?? Guid.Empty;
        if (mLoaded && mLoadedFor == target)
        {
            return;
        }

        mLoaded = true;
        mLoadedFor = target;
        mAttachError = null;

        if (Editing is not null)
        {
            mType = Enum.TryParse(Editing.Type, out SoccerTeamPostType parsed) ? parsed : SoccerTeamPostType.Notice;
            mTitle = Editing.Title;
            mBody = Editing.Body;
            mIsPublic = Editing.IsPublic;
            mFiles = Editing.Files
                .Select(f => new TeamPostFileInput { Url = f.FileUrl, Name = f.FileName, SizeBytes = f.SizeBytes })
                .ToList();
        }
        else
        {
            mType = SoccerTeamPostType.Notice;
            mTitle = string.Empty;
            mBody = string.Empty;
            mIsPublic = false; // 기본 끔 — 실수 공개 방지
            mFiles = new List<TeamPostFileInput>();
        }
    }

    private void OnTypeChanged(SoccerTeamPostType type) => mType = type;

    private static string? ValidateTitle(string? value)
    {
        string trimmed = (value ?? string.Empty).Trim();
        if (trimmed.Length < 2)
        {
            return "제목을 2자 이상 입력해 주세요.";
        }

        return trimmed.Length > 60 ? "제목은 60자를 넘을 수 없어요." : null;
    }

    private static string? ValidateBody(string? value)
    {
        string trimmed = (value ?? string.Empty).Trim();
        return trimmed.Length < 2 ? "내용을 2자 이상 입력해 주세요." : null;
    }

    private async Task OnFilesPickedAsync(InputFileChangeEventArgs args)
    {
        mAttachError = null;
        mUploading = true;

        foreach (IBrowserFile file in args.GetMultipleFiles(MaxFiles))
        {
            if (mFiles.Count >= MaxFiles)
            {
                mAttachError = $"첨부는 {MaxFiles}개까지 올릴 수 있어요.";
                break;
            }

            if (file.Size > MaxBytes)
            {
                mAttachError = $"{file.Name}이(가) 너무 커요 — 10MB 이하로 올려 주세요.";
                continue;
            }

            UploadedFileResponse? uploaded = await Teams.UploadBoardFileAsync(file);
            if (uploaded is null)
            {
                mAttachError = $"{file.Name}을(를) 올리지 못했어요. 형식(pdf·이미지·hwp)과 용량을 확인해 주세요.";
                continue;
            }

            mFiles.Add(new TeamPostFileInput { Url = uploaded.Url, Name = uploaded.FileName, SizeBytes = uploaded.SizeBytes });
        }

        mUploading = false;
    }

    private void RemoveFile(TeamPostFileInput file) => mFiles.Remove(file);

    private static string SizeText(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / (1024.0 * 1024.0):0.0}MB";
        }

        return $"{Math.Max(1, bytes / 1024)}KB";
    }

    private async Task SubmitAsync()
    {
        bool fieldsValid = await mForm.ValidateAllAsync();
        if (!fieldsValid)
        {
            return;
        }

        var request = new SaveTeamPostRequest
        {
            PostId = Editing?.PostId ?? Guid.Empty,
            Type = mType.ToString(),
            Title = mTitle.Trim(),
            Body = mBody.Trim(),
            IsPublic = mIsPublic,
            Files = mFiles,
        };

        mSaving = true;
        BoardPostSaveResult result = await Teams.SavePostAsync(request);
        mSaving = false;

        if (!result.Success)
        {
            if (result.IsNetworkError)
            {
                Toasts.ShowError(result.Error ?? "저장하지 못했어요.", "재시도", SubmitAsync);
            }
            else
            {
                Toasts.ShowError(result.Error ?? "저장하지 못했어요.");
            }

            return;
        }

        Toasts.ShowSuccess(IsEdit
            ? "글을 저장했어요."
            : (mType == SoccerTeamPostType.Notice ? "공지를 올렸어요. 소속 보호자에게 알림이 갔어요." : "자료를 올렸어요."));
        await IsOpenChanged.InvokeAsync(false);
        await OnSaved.InvokeAsync();
    }

    private async Task CancelAsync()
    {
        await IsOpenChanged.InvokeAsync(false);
    }
}

@* 데이터 내려받기 요청 (Design.SettingsFlows ③) — PC 중앙 모달 / 모바일 바텀시트.
   포함 항목 체크 3종 + 형식·24시간·7일 안내. 요청 = 접수(백그라운드 잡) → 상태 행으로 전환.
   InProgress/Cooldown은 인라인 안내(토스트 아님). 성공 = 토스트 + 상태 폴링. *@
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Export
@inject ExportClient Exports
@inject ToastService Toasts

@if (IsOpen)
{
    <div class="@Css.MatchForm.Overlay">
        <div class="fixed inset-0" @onclick="CancelAsync"></div>

        <div class="@Css.MatchForm.Card">
            <span class="@Css.MatchForm.GrabBar"></span>

            <div class="@Css.MatchForm.Header">
                <span class="flex flex-col gap-1 min-w-0">
                    <h2 class="@Css.MatchForm.Title">데이터 내려받기</h2>
                    <span class="@Css.MatchForm.Subtitle">내 계정과 자녀의 정보를 파일로 받을 수 있어요</span>
                </span>
                <button type="button" aria-label="닫기" class="@Css.MatchForm.CloseButton" @onclick="CancelAsync">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>

            <div class="@Css.MatchForm.Body">
                <div class="flex flex-col gap-2">
                    <span class="text-[12px] font-extrabold text-navy-deep">포함 항목</span>
                    <label class="flex items-start gap-2.5 cursor-pointer">
                        <input type="checkbox" checked="@mIncludeProfile" @onchange="e => mIncludeProfile = (bool)e.Value!" class="mt-0.5 w-[18px] h-[18px] accent-navy" />
                        <span class="text-[12.5px] leading-[1.5] break-keep">계정·프로필 <span class="text-text-muted">(이름·연락처·역할·자녀 연결)</span></span>
                    </label>
                    <label class="flex items-start gap-2.5 cursor-pointer">
                        <input type="checkbox" checked="@mIncludeRecords" @onchange="e => mIncludeRecords = (bool)e.Value!" class="mt-0.5 w-[18px] h-[18px] accent-navy" />
                        <span class="text-[12.5px] leading-[1.5] break-keep">경기 기록·커리어 <span class="text-text-muted">(자녀별 출전·기록·수상)</span></span>
                    </label>
                    <label class="flex items-start gap-2.5 cursor-pointer">
                        <input type="checkbox" checked="@mIncludeRequests" @onchange="e => mIncludeRequests = (bool)e.Value!" class="mt-0.5 w-[18px] h-[18px] accent-navy" />
                        <span class="text-[12.5px] leading-[1.5] break-keep">요청·신청 내역 <span class="text-text-muted">(연결·열람 승인·지원·수정 신청)</span></span>
                    </label>
                    <span class="text-[11px] text-text-muted break-keep">형식: JSON + 사람이 읽는 CSV 요약 (사진·영상 원본은 제외 — URL 목록만)</span>
                </div>

                <div class="bg-surface-soft rounded-[10px] px-3 py-[11px] text-[11.5px] text-text-body leading-[1.55] break-keep">
                    파일 준비에 최대 <b>24시간</b>이 걸려요. 완료되면 알림을 보내드리고, 링크는 <b>7일</b> 뒤 만료돼요.
                </div>

                @if (mError is not null)
                {
                    <span class="@Css.Form.ErrorMessage">@mError</span>
                }
            </div>

            <div class="@Css.MatchForm.Footer">
                <button type="button" class="@Css.MatchForm.CancelButton" @onclick="CancelAsync">취소</button>
                <SubmitButton Label="요청하기" BusyLabel="요청 중…" IsBusy="@mSaving"
                              OnClick="SubmitAsync" Class="@Css.MatchForm.SubmitWidth" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>요청 접수 후 — 부모가 상태 행을 다시 불러온다(폴링 시작).</summary>
    [Parameter]
    public EventCallback OnRequested { get; set; }

    private bool mIncludeProfile = true;
    private bool mIncludeRecords = true;
    private bool mIncludeRequests = true;
    private bool mSaving;
    private string? mError;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            return;
        }

        // 닫힐 때 초기화 (다음 열림 대비)
        mIncludeProfile = true;
        mIncludeRecords = true;
        mIncludeRequests = true;
        mError = null;
    }

    private async Task SubmitAsync()
    {
        mError = null;
        if (!mIncludeProfile && !mIncludeRecords && !mIncludeRequests)
        {
            mError = "받을 항목을 하나 이상 선택해 주세요.";
            return;
        }

        mSaving = true;
        DataExportRequestResult? result = await Exports.RequestAsync(new CreateDataExportRequest
        {
            IncludeProfile = mIncludeProfile,
            IncludeRecords = mIncludeRecords,
            IncludeRequests = mIncludeRequests
        });
        mSaving = false;

        if (result is null)
        {
            Toasts.ShowError("요청하지 못했어요. 잠시 후 다시 시도해 주세요.", "재시도", SubmitAsync);
            return;
        }

        // 진행 중·쿨다운은 인라인 안내(모달 유지) — 요청 접수만 성공으로 닫는다
        if (result.Status == "InProgress")
        {
            mError = "이미 준비 중인 요청이 있어요. 완료된 후 다시 요청할 수 있어요.";
            return;
        }

        if (result.Status == "Cooldown")
        {
            mError = "최근에 요청했어요. 24시간 뒤에 다시 요청할 수 있어요.";
            return;
        }

        Toasts.ShowSuccess("요청을 접수했어요. 준비되면 알림을 보내드릴게요.");
        await IsOpenChanged.InvokeAsync(false);
        await OnRequested.InvokeAsync();
    }

    private async Task CancelAsync()
    {
        await IsOpenChanged.InvokeAsync(false);
    }
}

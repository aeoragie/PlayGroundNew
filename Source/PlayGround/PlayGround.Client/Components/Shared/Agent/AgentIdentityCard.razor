@* 에이전트 신원 카드 공용 (Design.AgentDashboard / Design.AgentViewApproval — 심사 화면·프로필 동일 컴포넌트).
   violet 보더 + 헤더 배경 .06 + 아바타 + "인증 에이전트" 뱃지 + 소속·등록연도 + 3스탯(중개 이력/평가/활동 지역).
   **연락처·이메일은 표시하지 않는다**(플랫폼 내 메시지로만 접촉 — 불변 규칙). violet은 에이전트 요소 전용 토큰. *@
@using PlayGround.Client.Styles
@using PlayGround.Contracts.Agent

<div class="bg-white border-1.5 border-agent/30 rounded-2xl overflow-hidden">
    <div class="bg-agent/[.06] px-4 py-3.5 md:px-[22px] md:py-[18px] flex items-center gap-3 md:gap-3.5">
        <Avatar Name="@Agent.Name" Tone="Avatar.AvatarTone.Agent" Size="44" Class="flex-none md:!hidden" />
        <Avatar Name="@Agent.Name" Tone="Avatar.AvatarTone.Agent" Size="56" Class="flex-none !hidden md:!flex" />
        <span class="flex flex-col gap-0.5 md:gap-[3px] flex-1 min-w-0">
            <span class="flex items-center gap-1.5 md:gap-2 flex-wrap">
                <span class="text-[14.5px] md:text-[16.5px] font-extrabold whitespace-nowrap">@Agent.Name</span>
                @if (Agent.IsVerified)
                {
                    <span class="@Css.Badge.Agent">인증 에이전트</span>
                }
            </span>
            @if (AgencyLine.Length > 0)
            {
                <span class="text-[11.5px] md:text-[12.5px] text-text-body whitespace-nowrap">@AgencyLine</span>
            }
        </span>
    </div>
    @if (HasStats)
    {
        <div class="px-4 py-3 md:px-[22px] md:py-4 flex gap-3.5 md:gap-[18px]">
            @if (Agent.BrokerageCount > 0)
            {
                <span class="flex flex-col gap-px md:gap-0.5 flex-1">
                    <span class="text-sm md:text-[17px] font-extrabold">@(Agent.BrokerageCount)명</span>
                    <span class="text-[10.5px] md:text-[11px] font-bold text-text-muted whitespace-nowrap">중개 이력</span>
                </span>
            }
            @if (Agent.Rating is not null)
            {
                <span class="flex flex-col gap-px md:gap-0.5 flex-1">
                    <span class="flex items-center gap-1 text-sm md:text-[17px] font-extrabold">
                        <svg width="12" height="12" viewBox="0 0 24 24" class="md:w-3.5 md:h-3.5 fill-current text-orange"><path d="M12 2l2.9 6.3 6.6.8-4.9 4.6 1.3 6.6-5.9-3.4-5.9 3.4 1.3-6.6-4.9-4.6 6.6-.8z"></path></svg>@Agent.Rating
                    </span>
                    <span class="text-[10.5px] md:text-[11px] font-bold text-text-muted whitespace-nowrap">팀·학부모 평가</span>
                </span>
            }
            @if (Agent.ActiveRegions is not null)
            {
                <span class="flex flex-col gap-px md:gap-0.5 flex-1">
                    <span class="text-sm md:text-[17px] font-extrabold whitespace-nowrap">@Agent.ActiveRegions</span>
                    <span class="text-[10.5px] md:text-[11px] font-bold text-text-muted whitespace-nowrap">활동 지역</span>
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public AgentProfileDto Agent { get; set; } = new();

    private string AgencyLine => string.Join(" · ", new[]
    {
        Agent.AgencyName,
        Agent.RegisteredYear is int year ? $"등록 {year}" : null,
    }.Where(v => v is not null));

    private bool HasStats =>
        Agent.BrokerageCount > 0 || Agent.Rating is not null || Agent.ActiveRegions is not null;
}

@* 결과 헤더 — Design.SearchFilter. 카운트(네이비) 상시 표시 + 조건 요약 + "필터 초기화"(필터 ≥1일 때만) + 우측 슬롯(정렬). *@
@using PlayGround.Client.Styles

<div class="flex items-center gap-2 md:gap-2.5 flex-wrap">
    <span class="@Css.SearchFilter.ResultCount">@AppText.Shared.CountSuffix(Count) @Unit</span>
    @if (Description is not null)
    {
        <span class="text-[11.5px] md:text-xs text-text-muted break-keep">@Description</span>
    }
    @if (ShowReset)
    {
        <button type="button" class="@Css.SearchFilter.ResultReset" @onclick="() => OnReset.InvokeAsync()">@AppText.Shared.ResetFilters</button>
    }
    <div class="flex-1"></div>
    @Right
</div>

@code {
    [Parameter, EditorRequired]
    public int Count { get; set; }

    [Parameter, EditorRequired]
    public string Unit { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public bool ShowReset { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    [Parameter]
    public RenderFragment? Right { get; set; }
}

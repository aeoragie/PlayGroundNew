<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PlayGround.Server</RootNamespace>
    <AssemblyName>PlayGround.Server</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- 로컬 개발 시크릿(JWT 키·OAuth Secret) — **배포 산출물에 절대 넣지 않는다.**
         Program.cs가 이 파일을 설정 체인 맨 뒤에 붙이므로, 산출물에 실리면 운영 환경변수를
         덮어써 개발용 키로 토큰이 서명된다. bin(개발 실행)에는 그대로 복사한다. -->
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- AspNetCore.OpenApi가 끌어오는 취약 transitive 2.0.0을 안전한 버전으로 덮어쓰기 위한 직접 참조 -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="NLog.Web.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <!-- 업로드 이미지·첨부 S3 저장 (UploadStorageConfiguration.Provider=Aws일 때) -->
    <PackageReference Include="AWSSDK.S3" />
    <!-- OG 카드 서버 렌더 PNG (DECISION.OGMETA) -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Shared\Core.Shared.csproj" />
    <ProjectReference Include="..\..\Core\Infrastructure\Core.Infrastructure.csproj" />
    <ProjectReference Include="..\PlayGround.Contracts\PlayGround.Contracts.csproj" />
    <ProjectReference Include="..\PlayGround.Application\PlayGround.Application.csproj" />
    <ProjectReference Include="..\PlayGround.Persistence\PlayGround.Persistence.csproj" />
    <ProjectReference Include="..\PlayGround.Client\PlayGround.Client.csproj" />
  </ItemGroup>

</Project>

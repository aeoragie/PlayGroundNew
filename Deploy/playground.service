# systemd 유닛 — /etc/systemd/system/playground.service 로 복사한다.
#
# 시크릿은 여기 두지 않는다. /etc/playground/playground.env (chmod 600) 에서 읽는다:
#   Jwt__Key=...
#   OAuth__Google__ClientSecret=...
#   DatabaseConfiguration__Databases__Account__ConnectionString=...
#   DatabaseConfiguration__Databases__Soccer__ConnectionString=...
#   RedisConfig__Connections__0__ConnectionString=localhost:6379
#
# 적용:  sudo systemctl daemon-reload && sudo systemctl enable --now playground

[Unit]
Description=PlayGround (ASP.NET Core + Blazor WASM)
After=network.target mssql-server.service redis-server.service
Wants=mssql-server.service redis-server.service

[Service]
# simple: 프로세스가 뜨면 시작으로 간주. notify는 앱의 UseSystemd() 준비 신호가 필요한데
# 우리 앱엔 없어서 restart가 90초 대기 후 실패를 반복했다(2026-08-09 첫 배포에서 실측).
# 실제 기동 확인은 deploy-app.sh가 HTTP로 직접 한다.
Type=simple
WorkingDirectory=/var/www/playground
ExecStart=/usr/bin/dotnet /var/www/playground/PlayGround.Server.dll
Restart=always
RestartSec=5
User=playground
Group=playground

# Nginx가 TLS를 종료하고 127.0.0.1로 넘긴다 — 앱은 외부에 직접 노출되지 않는다
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
EnvironmentFile=/etc/playground/playground.env

# 로그는 journald로 — journalctl -u playground -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=playground

# 최소 권한
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
